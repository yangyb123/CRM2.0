            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.math.BigDecimal;

String beforeStr = vars.get(&quot;before_balance&quot;);
String afterStr = vars.get(&quot;after_balance&quot;);
String mt5Str = vars.get(&quot;MT5_expected_commission&quot;);
String mt4Str = vars.get(&quot;MT4_expected_commission&quot;);

if (beforeStr == null) {
    beforeStr = &quot;&quot;;
}

if (afterStr == null) {
    afterStr = &quot;&quot;;
}

if (mt5Str == null) {
    mt5Str = &quot;&quot;;
}

if (mt4Str == null) {
    mt4Str = &quot;&quot;;
}

beforeStr = beforeStr.trim();
afterStr = afterStr.trim();
mt5Str = mt5Str.trim();
mt4Str = mt4Str.trim();

beforeStr = beforeStr.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();
afterStr = afterStr.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();
mt5Str = mt5Str.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();
mt4Str = mt4Str.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();

String finalMsg = &quot;&quot;;

try {
    BigDecimal beforeBalance = new BigDecimal(beforeStr);
    BigDecimal afterBalance = new BigDecimal(afterStr);
    BigDecimal mt5Commission = new BigDecimal(mt5Str);
    BigDecimal mt4Commission = new BigDecimal(mt4Str);

    BigDecimal actualIncrease = afterBalance.subtract(beforeBalance);
    BigDecimal expectedIncrease = mt5Commission.add(mt4Commission);

    String actualText = actualIncrease.stripTrailingZeros().toPlainString();
    String expectedText = expectedIncrease.stripTrailingZeros().toPlainString();

    String detail = &quot;返佣钱包余额断言：&quot;
        + &quot;before_balance=[&quot; + beforeStr + &quot;]，&quot;
        + &quot;after_balance=[&quot; + afterStr + &quot;]，&quot;
        + &quot;实际增加金额=after_balance-before_balance=[&quot; + actualText + &quot;]，&quot;
        + &quot;MT5_expected_commission=[&quot; + mt5Str + &quot;]，&quot;
        + &quot;MT4_expected_commission=[&quot; + mt4Str + &quot;]，&quot;
        + &quot;预期增加金额=MT5_expected_commission+MT4_expected_commission=[&quot; + expectedText + &quot;]&quot;;

    if (actualIncrease.compareTo(expectedIncrease) == 0) {
        finalMsg = &quot;断言通过：&quot; + detail;

        AssertionResult.setFailure(false);

        prev.setSuccessful(true);
        prev.setResponseCode(&quot;200&quot;);
        prev.setResponseMessage(finalMsg);

        log.info(finalMsg);
    } else {
        finalMsg = &quot;断言失败：&quot; + detail;

        AssertionResult.setFailure(true);
        AssertionResult.setFailureMessage(finalMsg);

        prev.setSuccessful(false);
        prev.setResponseCode(&quot;500&quot;);
        prev.setResponseMessage(finalMsg);

        log.error(finalMsg);
    }

    vars.put(&quot;commission_wallet_balance_assert_detail&quot;, finalMsg);
    vars.put(&quot;commission_wallet_actual_increase&quot;, actualText);
    vars.put(&quot;commission_wallet_expected_increase&quot;, expectedText);
} catch (Exception e) {
    finalMsg = &quot;返佣钱包余额断言异常：&quot;
        + &quot;before_balance=[&quot; + beforeStr + &quot;]，&quot;
        + &quot;after_balance=[&quot; + afterStr + &quot;]，&quot;
        + &quot;MT5_expected_commission=[&quot; + mt5Str + &quot;]，&quot;
        + &quot;MT4_expected_commission=[&quot; + mt4Str + &quot;]，&quot;
        + &quot;异常信息=[&quot; + e.getMessage() + &quot;]&quot;;

    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMsg);

    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(finalMsg);

    log.error(finalMsg);

    vars.put(&quot;commission_wallet_balance_assert_detail&quot;, finalMsg);
}</stringProp>
            </JSR223Assertion>
