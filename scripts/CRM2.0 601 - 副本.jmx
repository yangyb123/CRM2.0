              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }
    return value.trim();
}

String getVar(String name) {
    return clean(vars.get(name));
}

// 兜底读取变量：用于处理 amountUSD 变量名后面误带空格的情况
String getVarWithFallback(String name1, String name2) {
    String value = clean(vars.get(name1));
    if (value.length() == 0) {
        value = clean(vars.get(name2));
    }
    return value;
}

// 普通提取失败判断：空值、NOT_FOUND、null 都认为失败
boolean isExtractFail(String value) {
    String text = clean(value);
    return text.length() == 0 || &quot;NOT_FOUND&quot;.equals(text) || &quot;null&quot;.equalsIgnoreCase(text);
}

// 允许空字符串的提取失败判断：
// 用于 fromCurrency，因为 fromCurrency 有些业务场景本身可能就是 &quot;&quot;
boolean isExtractFailAllowEmpty(String value) {
    String text = clean(value);
    return &quot;NOT_FOUND&quot;.equals(text) || &quot;null&quot;.equalsIgnoreCase(text);
}

// 金额比较：兼容 10、10.0、10.00、10.00000
boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// ----------------------读取实际提取值----------------------

String actAmountUsd = getVar(&quot;get_amountUsd&quot;);
String actFromAccount = getVar(&quot;get_fromAccount&quot;);
String actToAccount = getVar(&quot;get_toAccount&quot;);
String actFromCurrency = getVar(&quot;get_fromCurrency&quot;);
String actToCurrency = getVar(&quot;get_toCurrency&quot;);
String actStatus = getVar(&quot;get_status&quot;);

// ----------------------读取预期值----------------------

String expAmountUsd = getVar(&quot;amountUSD&quot;);
String expFromAccount = getVar(&quot;account&quot;);
String expToAccount = getVar(&quot;toAccount&quot;);
String expFromCurrency = getVar(&quot;fromCurrency&quot;);
String expToCurrency = getVar(&quot;toCurrency&quot;);
String expStatus =  getVar(&quot;status&quot;);

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;

// ----------------------判断实际提取值是否成功----------------------

if (isExtractFail(actAmountUsd)) {
    errorCollect += &quot;【get_amountUsd 提取失败】实际值：[&quot; + actAmountUsd + &quot;]\n&quot;;
}

if (isExtractFail(actFromAccount)) {
    errorCollect += &quot;【get_fromAccount 提取失败】实际值：[&quot; + actFromAccount + &quot;]\n&quot;;
}

if (isExtractFail(actToAccount)) {
    errorCollect += &quot;【get_toAccount 提取失败】实际值：[&quot; + actToAccount + &quot;]\n&quot;;
}

// fromCurrency 允许业务值为空字符串，所以这里只拦截 NOT_FOUND/null
if (isExtractFailAllowEmpty(actFromCurrency)) {
    errorCollect += &quot;【get_fromCurrency 提取失败】实际值：[&quot; + actFromCurrency + &quot;]\n&quot;;
}

if (isExtractFailAllowEmpty(actToCurrency)) {
    errorCollect += &quot;【get_toCurrency 提取失败】实际值：[&quot; + actToCurrency + &quot;]\n&quot;;
}

if (isExtractFail(actStatus)) {
    errorCollect += &quot;【get_status 提取失败】实际值：[&quot; + actStatus + &quot;]\n&quot;;
}

// ----------------------判断预期变量是否存在----------------------

if (expAmountUsd.length() == 0) {
    errorCollect += &quot;【amountUSD 预期变量为空】无法断言 get_amountUsd；请检查 CSV 变量名是否为 amountUSD\n&quot;;
}

if (expFromAccount.length() == 0) {
    errorCollect += &quot;【account 预期变量为空】无法断言 get_fromAccount\n&quot;;
}

if (expToAccount.length() == 0) {
    errorCollect += &quot;【toAccount 预期变量为空】无法断言 get_toAccount\n&quot;;
}

// fromCurrency 允许为空，所以这里不强制认为空值失败
// 如果你的业务要求 fromCurrency 必须有值，可以打开下面这段
// if (expFromCurrency.length() == 0) {
//     errorCollect += &quot;【fromCurrency 预期变量为空】无法断言 get_fromCurrency\n&quot;;
// }
// toCurrencywallet 该场景预期为空，所以这里不校验 expToCurrency 是否为空
//if (expToCurrency.length() == 0) {
//    errorCollect += &quot;【toCurrency 预期变量为空】无法断言 get_toCurrency\n&quot;;
//}

// ----------------------1. get_amountUsd = amountUSD----------------------
// 金额字段使用 BigDecimal 比较，兼容 6.59、6.590、6.5900

if (expAmountUsd.length() &gt; 0 &amp;&amp; !isExtractFail(actAmountUsd)) {
    if (!numberEquals(expAmountUsd, actAmountUsd)) {
        errorCollect += &quot;【get_amountUsd 断言失败】预期 amountUSD：[&quot; + expAmountUsd + &quot;]，实际 get_amountUsd：[&quot; + actAmountUsd + &quot;]\n&quot;;
    }
}

// ----------------------2. get_fromAccount = account----------------------

if (expFromAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actFromAccount)) {
    if (!expFromAccount.equals(actFromAccount)) {
        errorCollect += &quot;【get_fromAccount 断言失败】预期 account：[&quot; + expFromAccount + &quot;]，实际 get_fromAccount：[&quot; + actFromAccount + &quot;]\n&quot;;
    }
}

// ----------------------3. get_toAccount = toAccount----------------------

if (expToAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actToAccount)) {
    if (!expToAccount.equals(actToAccount)) {
        errorCollect += &quot;【get_toAccount 断言失败】预期 toAccount：[&quot; + expToAccount + &quot;]，实际 get_toAccount：[&quot; + actToAccount + &quot;]\n&quot;;
    }
}

// ----------------------4. get_fromCurrency = fromCurrency----------------------
// fromCurrency 允许空字符串参与比较，例如预期 &quot;&quot;，实际 &quot;&quot;，则通过
if (!isExtractFailAllowEmpty(actFromCurrency)) {
    if (!expFromCurrency.equals(actFromCurrency)) {
        errorCollect += &quot;【get_fromCurrency 断言失败】预期 fromCurrency：[&quot; + expFromCurrency + &quot;]，实际 get_fromCurrency：[&quot; + actFromCurrency + &quot;]\n&quot;;
    }
}

// ----------------------5. get_toCurrency = toCurrency----------------------
// toCurrency 允许空字符串参与比较，例如预期 &quot;&quot;，实际 &quot;&quot;，则通过
if (!isExtractFailAllowEmpty(actToCurrency)) {
    if (!expToCurrency.equals(actToCurrency)) {
        errorCollect += &quot;【get_toCurrency 断言失败】预期 toCurrency：[&quot; + expToCurrency + &quot;]，实际 get_toCurrency：[&quot; + actToCurrency + &quot;]\n&quot;;
    }
}


// ----------------------6. get_status = status----------------------
// 状态字段固定要求为 0，使用字符串比较，避免 int/string 类型问题

if (!isExtractFail(actStatus)) {
    if (!expStatus.equals(actStatus)) {
        errorCollect += &quot;【get_status 断言失败】预期：预期 status：[&quot; + expStatus + &quot;]，实际 get_status：[&quot; + actStatus + &quot;]\n&quot;;
    }
}

// ----------------------收集断言检查明细----------------------
passCollect += &quot;【检查】get_amountUsd = amountUSD，预期：[&quot; + expAmountUsd + &quot;]，实际：[&quot; + actAmountUsd + &quot;]\n&quot;;
passCollect += &quot;【检查】get_fromAccount = account，预期：[&quot; + expFromAccount + &quot;]，实际：[&quot; + actFromAccount + &quot;]\n&quot;;
passCollect += &quot;【检查】get_toAccount = toAccount，预期：[&quot; + expToAccount + &quot;]，实际：[&quot; + actToAccount + &quot;]\n&quot;;
passCollect += &quot;【检查】get_fromCurrency = fromCurrency，预期：[&quot; + expFromCurrency + &quot;]，实际：[&quot; + actFromCurrency + &quot;]\n&quot;;
passCollect += &quot;【检查】get_toCurrency = toCurrency，预期：[&quot; + expToCurrency + &quot;]，实际：[&quot; + actToCurrency + &quot;]\n&quot;;
passCollect += &quot;【检查】get_status = status，预期：[&quot; + expStatus + &quot;]，实际：[&quot; + actStatus + &quot;]\n&quot;;

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言检查明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 1. 输出到 jmeter.log
log.info(finalMessage);

// 2. 保存到 JMeter 变量，可用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 3. 写入当前请求的 Response Message，可在察看结果树中查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 4. 控制断言成功/失败
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);

    AssertionResult.setFailureMessage(finalMessage);
}
</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
