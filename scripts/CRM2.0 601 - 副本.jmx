            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223断言" enabled="true">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.math.BigDecimal;

boolean hasFailure = false;

StringBuilder passMsg = new StringBuilder();
StringBuilder failMsg = new StringBuilder();

passMsg.append(&quot;========== 返佣字段断言通过明细 ==========\n&quot;);
failMsg.append(&quot;========== 返佣字段断言失败明细 ==========\n&quot;);


// ===================== 获取变量 =====================

String MT5_commission_cmd = vars.get(&quot;MT5_commission_cmd&quot;);
String MT5_cmd = vars.get(&quot;MT5_cmd&quot;);

String MT4_commission_cmd = vars.get(&quot;MT4_commission_cmd&quot;);
String MT4_cmd = vars.get(&quot;MT4_cmd&quot;);

String MT5_commission_Amount = vars.get(&quot;MT5_commission_Amount&quot;);
String MT5_expected_commission = vars.get(&quot;MT5_expected_commission&quot;);

String MT4_commission_Amount = vars.get(&quot;MT4_commission_Amount&quot;);
String MT4_expected_commission = vars.get(&quot;MT4_expected_commission&quot;);


// ===================== 工具方法 =====================

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    String v = value.trim();

    // 兼容 JSON 提取器返回 [&quot;0.5600&quot;] 或 [&quot;2&quot;] 的情况
    v = v.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();

    return v;
}

boolean textEq(String a, String b) {
    return clean(a).equals(clean(b));
}

boolean numEq(String a, String b) {
    try {
        BigDecimal n1 = new BigDecimal(clean(a));
        BigDecimal n2 = new BigDecimal(clean(b));
        return n1.compareTo(n2) == 0;
    } catch (Exception e) {
        return textEq(a, b);
    }
}

String minusOne(String value) {
    try {
        BigDecimal num = new BigDecimal(clean(value));
        BigDecimal result = num.subtract(new BigDecimal(&quot;1&quot;));
        return result.stripTrailingZeros().toPlainString();
    } catch (Exception e) {
        return &quot;&quot;;
    }
}

void check(boolean condition, String fieldName, String detail) {
    if (condition) {
        passMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】断言通过：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    } else {
        hasFailure = true;
        failMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】断言失败：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    }
}


// ===================== 转换 commission_cmd =====================

String MT5_commission_cmd_after = minusOne(MT5_commission_cmd);
String MT4_commission_cmd_after = minusOne(MT4_commission_cmd);


// ===================== 断言逻辑 =====================

check(
    numEq(MT5_commission_cmd_after, MT5_cmd),
    &quot;MT5_commission_cmd - 1 = MT5_cmd&quot;,
    &quot;MT5_commission_cmd原始值=[&quot; + clean(MT5_commission_cmd) + &quot;]，&quot;
        + &quot;MT5_commission_cmd-1=[&quot; + MT5_commission_cmd_after + &quot;]，&quot;
        + &quot;MT5_cmd=[&quot; + clean(MT5_cmd) + &quot;]&quot;
);

check(
    numEq(MT4_commission_cmd_after, MT4_cmd),
    &quot;MT4_commission_cmd - 1 = MT4_cmd&quot;,
    &quot;MT4_commission_cmd原始值=[&quot; + clean(MT4_commission_cmd) + &quot;]，&quot;
        + &quot;MT4_commission_cmd-1=[&quot; + MT4_commission_cmd_after + &quot;]，&quot;
        + &quot;MT4_cmd=[&quot; + clean(MT4_cmd) + &quot;]&quot;
);

check(
    numEq(MT5_commission_Amount, MT5_expected_commission),
    &quot;MT5_commission_Amount = MT5_expected_commission&quot;,
    &quot;MT5_commission_Amount=[&quot; + clean(MT5_commission_Amount) + &quot;]，&quot;
        + &quot;MT5_expected_commission=[&quot; + clean(MT5_expected_commission) + &quot;]&quot;
);

check(
    numEq(MT4_commission_Amount, MT4_expected_commission),
    &quot;MT4_commission_Amount = MT4_expected_commission&quot;,
    &quot;MT4_commission_Amount=[&quot; + clean(MT4_commission_Amount) + &quot;]，&quot;
        + &quot;MT4_expected_commission=[&quot; + clean(MT4_expected_commission) + &quot;]&quot;
);


// ===================== 输出结果 =====================

String finalMsg = &quot;&quot;;

if (hasFailure) {
    finalMsg = failMsg.toString() + &quot;\n&quot; + passMsg.toString();

    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMsg);

    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(finalMsg);

    log.error(finalMsg);
} else {
    finalMsg = passMsg.toString();

    AssertionResult.setFailure(false);

    prev.setSuccessful(true);
    prev.setResponseCode(&quot;200&quot;);
    prev.setResponseMessage(finalMsg);

    log.info(finalMsg);
}

vars.put(&quot;commission_field_assert_detail&quot;, finalMsg);
vars.put(&quot;MT5_commission_cmd_after&quot;, MT5_commission_cmd_after);
vars.put(&quot;MT4_commission_cmd_after&quot;, MT4_commission_cmd_after);</stringProp>
            </JSR223Assertion>
