              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="清洗入金金额字段" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

String extractNumber(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    Pattern p = Pattern.compile(&quot;-?\\d+(\\.\\d+)?&quot;);
    Matcher m = p.matcher(value);

    if (m.find()) {
        return m.group(0);
    }

    return &quot;&quot;;
}

// 读取原始提取值
String depositAmountRaw = vars.get(&quot;get_depositAmount&quot;);
String submitAmountRaw = vars.get(&quot;get_submitAmount&quot;);

// 提取纯数字
String depositAmountClean = extractNumber(depositAmountRaw);
String submitAmountClean = extractNumber(submitAmountRaw);

// 覆盖原变量
vars.put(&quot;get_depositAmount&quot;, depositAmountClean);
vars.put(&quot;get_submitAmount&quot;, submitAmountClean);

// 可选：保留原始值，方便调试
vars.put(&quot;get_depositAmount_raw&quot;, depositAmountRaw == null ? &quot;&quot; : depositAmountRaw);
vars.put(&quot;get_submitAmount_raw&quot;, submitAmountRaw == null ? &quot;&quot; : submitAmountRaw);</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.math.BigDecimal;

// ========================
// 工具方法
// ========================

// null 转空字符串，并去掉前后空格
String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }
    return value.trim();
}

// 金额比较：兼容 10、10.0、10.00、10.00000、前后空格
boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// 获取数字转换错误信息
String numberCompareError(String fieldName, String expected, String actual) {
    return &quot;【&quot; + fieldName + &quot; 断言失败】预期：&quot; + clean(expected) + &quot;，实际：&quot; + clean(actual) + &quot;\n&quot;;
}

// ========================
// 读取 JMeter 变量
// ========================

String expAmount = clean(vars.get(&quot;amount&quot;));
String actAmount = clean(vars.get(&quot;get_amount&quot;));

String expDepositAmount = clean(vars.get(&quot;amountUSD&quot;));
String actDepositAmount = clean(vars.get(&quot;get_depositAmount&quot;));

String expSubmitAmount = clean(vars.get(&quot;amountUSD&quot;));
String actSubmitAmount = clean(vars.get(&quot;get_submitAmount&quot;));

String expAccount = clean(vars.get(&quot;account&quot;));
String actAccount = clean(vars.get(&quot;get_accountNo&quot;));

String expCurrencyId = clean(vars.get(&quot;currencyId&quot;));
String actCurrencyId = clean(vars.get(&quot;get_currency&quot;));

int expStatus = 0;
int actStatus = -1;

String errorCollect = &quot;&quot;;

// ========================
// 状态转换
// ========================

try {
    String statusStr = clean(vars.get(&quot;get_status&quot;));

    if (statusStr.length() == 0) {
        throw new Exception(&quot;get_status变量为空&quot;);
    }

    actStatus = Integer.parseInt(statusStr);
} catch (Exception e) {
    errorCollect += &quot;【get_status 转换失败】&quot; + e.getMessage() + &quot;\n&quot;;
}

// ========================
// 金额字段断言
// ========================

// get_amount
if (!numberEquals(expAmount, actAmount)) {
    errorCollect += numberCompareError(&quot;get_amount&quot;, expAmount, actAmount);
}

// get_depositAmount
if (!numberEquals(expDepositAmount, actDepositAmount)) {
    errorCollect += numberCompareError(&quot;get_depositAmount&quot;, expDepositAmount, actDepositAmount);
}

// get_submitAmount
if (!numberEquals(expSubmitAmount, actSubmitAmount)) {
    errorCollect += numberCompareError(&quot;get_submitAmount&quot;, expSubmitAmount, actSubmitAmount);
}

// ========================
// 文本字段断言
// ========================

// get_accountNo
if (!expAccount.equals(actAccount)) {
    errorCollect += &quot;【get_accountNo 断言失败】预期：&quot; + expAccount + &quot;，实际：&quot; + actAccount + &quot;\n&quot;;
}

// get_currency
if (!expCurrencyId.equals(actCurrencyId)) {
    errorCollect += &quot;【get_currency 断言失败】预期：&quot; + expCurrencyId + &quot;，实际：&quot; + actCurrencyId + &quot;\n&quot;;
}

// ========================
// 状态断言
// ========================

if (actStatus != expStatus) {
    errorCollect += &quot;【get_status 断言失败】预期：&quot; + expStatus + &quot;，实际：&quot; + actStatus + &quot;\n&quot;;
}

// ========================
// 汇总断言结果
// ========================

if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;多字段断言汇总失败：\n&quot; + errorCollect);
} else {
    AssertionResult.setFailure(false);
}</stringProp>
              </JSR223Assertion>
