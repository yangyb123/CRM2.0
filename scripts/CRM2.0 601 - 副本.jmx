            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.math.BigDecimal;

StringBuffer passCollect = new StringBuffer();
StringBuffer errorCollect = new StringBuffer();

int passCount = 0;
int failCount = 0;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }
    return value.trim();
}

boolean isInvalid(String value) {
    String text = clean(value);
    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

String fmt(BigDecimal value) {
    return value.stripTrailingZeros().toPlainString();
}

void addPass(StringBuffer passCollect, String msg) {
    String fullMsg = &quot;【成功】&quot; + msg;
    passCollect.append(fullMsg).append(&quot;\n&quot;);
    log.info(fullMsg);
    System.out.println(fullMsg);
}

void addFail(StringBuffer errorCollect, String msg) {
    String fullMsg = &quot;【失败】&quot; + msg;
    errorCollect.append(fullMsg).append(&quot;\n&quot;);
    log.error(fullMsg);
    System.out.println(fullMsg);
}

boolean checkReduce(
    String title,
    String beforeName,
    String beforeText,
    String afterName,
    String afterText,
    String expectedName,
    String expectedText,
    StringBuffer passCollect,
    StringBuffer errorCollect
) {
    if (isInvalid(beforeText)) {
        addFail(errorCollect, title + &quot;，&quot; + beforeName + &quot; 提取失败，实际值=[&quot; + clean(beforeText) + &quot;]&quot;);
        return false;
    }

    if (isInvalid(afterText)) {
        addFail(errorCollect, title + &quot;，&quot; + afterName + &quot; 提取失败，实际值=[&quot; + clean(afterText) + &quot;]&quot;);
        return false;
    }

    if (isInvalid(expectedText)) {
        addFail(errorCollect, title + &quot;，&quot; + expectedName + &quot; 为空或无效，预期值=[&quot; + clean(expectedText) + &quot;]&quot;);
        return false;
    }

    try {
        BigDecimal beforeValue = new BigDecimal(clean(beforeText));
        BigDecimal afterValue = new BigDecimal(clean(afterText));
        BigDecimal expectedValue = new BigDecimal(clean(expectedText));

        BigDecimal actualReduce = beforeValue.subtract(afterValue);
        boolean ok = actualReduce.compareTo(expectedValue) == 0;

        String detail = title
            + &quot;，&quot; + beforeName + &quot;=[&quot; + fmt(beforeValue) + &quot;]&quot;
            + &quot;，&quot; + afterName + &quot;=[&quot; + fmt(afterValue) + &quot;]&quot;
            + &quot;，实际减少 &quot; + beforeName + &quot; - &quot; + afterName + &quot;=[&quot; + fmt(actualReduce) + &quot;]&quot;
            + &quot;，预期 &quot; + expectedName + &quot;=[&quot; + fmt(expectedValue) + &quot;]&quot;;

        if (ok) {
            addPass(passCollect, detail);
            return true;
        } else {
            addFail(errorCollect, detail);
            return false;
        }
    } catch (Exception e) {
        addFail(
            errorCollect,
            title + &quot;，数字转换失败，&quot;
            + beforeName + &quot;=[&quot; + clean(beforeText) + &quot;]，&quot;
            + afterName + &quot;=[&quot; + clean(afterText) + &quot;]，&quot;
            + expectedName + &quot;=[&quot; + clean(expectedText) + &quot;]，异常：&quot; + e.getMessage()
        );
        return false;
    }
}

// ----------------------读取实际值----------------------

String balanceBefore = clean(vars.get(&quot;balance_before&quot;));
String balanceAfter = clean(vars.get(&quot;balance_after&quot;));
String creditBefore = clean(vars.get(&quot;credit_before&quot;));
String creditAfter = clean(vars.get(&quot;credit_after&quot;));

// ----------------------读取预期值----------------------
// 当前接口请求写死：后台出金 amount=200，后台出信用金 amount=9

String expBalanceReduce = &quot;200&quot;;
String expCreditReduce = &quot;9&quot;;

// ----------------------逐条断言----------------------
// 出金：余额应该减少 200
// 出信用金：信用金应该减少 9

boolean r1 = checkReduce(
    &quot;出金余额校验：balance_before - balance_after = 200&quot;,
    &quot;balance_before&quot;,
    balanceBefore,
    &quot;balance_after&quot;,
    balanceAfter,
    &quot;出金金额&quot;,
    expBalanceReduce,
    passCollect,
    errorCollect
);

if (r1) {
    passCount++;
} else {
    failCount++;
}

boolean r2 = checkReduce(
    &quot;出信用金校验：credit_before - credit_after = 9&quot;,
    &quot;credit_before&quot;,
    creditBefore,
    &quot;credit_after&quot;,
    creditAfter,
    &quot;出信用金金额&quot;,
    expCreditReduce,
    passCollect,
    errorCollect
);

if (r2) {
    passCount++;
} else {
    failCount++;
}

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;&quot;;
finalMessage = finalMessage + &quot;========== 出金后查询余额 JSR223 断言结果明细 ==========\n&quot;;
finalMessage = finalMessage + &quot;断言总数：2，成功：&quot; + passCount + &quot;，失败：&quot; + failCount + &quot;\n&quot;;

finalMessage = finalMessage + &quot;\n【断言成功明细】\n&quot;;
if (passCollect.length() &gt; 0) {
    finalMessage = finalMessage + passCollect.toString();
} else {
    finalMessage = finalMessage + &quot;无成功断言\n&quot;;
}

finalMessage = finalMessage + &quot;\n【断言失败明细】\n&quot;;
if (errorCollect.length() &gt; 0) {
    finalMessage = finalMessage + errorCollect.toString();
} else {
    finalMessage = finalMessage + &quot;无失败断言\n&quot;;
}

if (failCount &gt; 0) {
    finalMessage = finalMessage + &quot;\n【最终结果】存在断言失败\n&quot;;
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    finalMessage = finalMessage + &quot;\n【最终结果】全部断言通过\n&quot;;
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}

finalMessage = finalMessage + &quot;========================================&quot;;

log.info(finalMessage);
System.out.println(finalMessage);

vars.put(&quot;assert_result_detail&quot;, finalMessage);
vars.put(&quot;withdraw_balance_assert_detail&quot;, finalMessage);

String oldMsg = prev.getResponseMessage();
if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}</stringProp>
            </JSR223Assertion>
