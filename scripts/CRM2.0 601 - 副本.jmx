            <stringProp name="script">// 直接使用JMeter内置的循环索引，0 = 第一次循环，1 = 第二次循环
String idxStr = vars.get(&quot;__jm__archive__idx&quot;);
int count = (idxStr == null || idxStr.isEmpty()) ? 0 : Integer.parseInt(idxStr);

if (count == 0) {
    vars.put(&quot;mtServerId&quot;, vars.get(&quot;mtServerId41&quot;));
    vars.put(&quot;login&quot;, vars.get(&quot;archive41&quot;));
} else {
    vars.put(&quot;mtServerId&quot;, vars.get(&quot;mtServerId51&quot;));
    vars.put(&quot;login&quot;, vars.get(&quot;archive51&quot;));
}
</stringProp>
