              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();
    value = value.replace(&quot;\uFEFF&quot;, &quot;&quot;);
    value = value.replace(&quot;\u200B&quot;, &quot;&quot;);
    value = value.replace(&quot;\u00A0&quot;, &quot;&quot;);

    // 兼容提取到 [&quot;xxx&quot;] 的情况
    if (value.startsWith(&quot;[&quot;) &amp;&amp; value.endsWith(&quot;]&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1).trim();
    }

    // 兼容提取到 &quot;xxx&quot; 的情况
    if (value.startsWith(&quot;\&quot;&quot;) &amp;&amp; value.endsWith(&quot;\&quot;&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1).trim();
    }

    return value.trim();
}

String getVar(String name) {
    return clean(vars.get(name));
}

boolean isExtractFail(String value) {
    String text = clean(value);

    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

// 允许空字符串作为业务有效值，只把 NOT_FOUND/null 当成提取失败
boolean isExtractFailAllowEmpty(String value) {
    String text = clean(value);

    return &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// 处理 tradingAccount 返回值：
// User Wallet (U7LCYE) -&gt; U7LCYE
// User wallet (U7LCYE) -&gt; U7LCYE
// MT Account (3077) -&gt; 3077
// Commission Wallet -&gt; Commission Wallet
String normalizeTradingAccount(String value) {
    String text = clean(value);

    int left = text.lastIndexOf(&quot;(&quot;);
    int right = text.lastIndexOf(&quot;)&quot;);

    if (left &gt;= 0 &amp;&amp; right &gt; left) {
        return clean(text.substring(left + 1, right));
    }

    return text;
}

// ----------------------读取实际提取值----------------------

String actTotal = getVar(&quot;get_total&quot;);
String actDebitAmountUsd = getVar(&quot;debitAmountUsd&quot;);
String actOutTradingAccount = getVar(&quot;OuttradingAccount&quot;);
String actCreditAmountUsd = getVar(&quot;creditAmountUsd&quot;);
String actInTradingAccount = getVar(&quot;IntradingAccount&quot;);
String actOutCurrency = getVar(&quot;get_Outcurrency&quot;);
String actInCurrency = getVar(&quot;get_Incurrency&quot;);

// ----------------------读取预期值----------------------

String expTotal = &quot;2&quot;;
String expAmountUsd = &quot;0.5&quot;;
String expDebitAmountUsd = expAmountUsd;
String expCreditAmountUsd = expAmountUsd;
String expOutTradingAccount = &quot;Commission Wallet&quot;;
String expInTradingAccount = &quot;User Wallet (U7LCYE)&quot;;
String expOutCurrency = &quot;USD&quot;;
String expInCurrency = &quot;USD&quot;;

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;

// ----------------------提取值检查----------------------

if (isExtractFail(actTotal)) {
    errorCollect += &quot;【get_total 提取失败】实际值：[&quot; + actTotal + &quot;]\n&quot;;
}

if (isExtractFail(actDebitAmountUsd)) {
    errorCollect += &quot;【debitAmountUsd 提取失败】实际值：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
}

if (isExtractFail(actOutTradingAccount)) {
    errorCollect += &quot;【OuttradingAccount 提取失败】实际值：[&quot; + actOutTradingAccount + &quot;]\n&quot;;
}

if (isExtractFail(actCreditAmountUsd)) {
    errorCollect += &quot;【creditAmountUsd 提取失败】实际值：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
}

if (isExtractFail(actInTradingAccount)) {
    errorCollect += &quot;【IntradingAccount 提取失败】实际值：[&quot; + actInTradingAccount + &quot;]\n&quot;;
}

// currency 允许为空，所以只拦截 NOT_FOUND/null
if (isExtractFailAllowEmpty(actOutCurrency)) {
    errorCollect += &quot;【get_Outcurrency 提取失败】实际值：[&quot; + actOutCurrency + &quot;]\n&quot;;
}

if (isExtractFailAllowEmpty(actInCurrency)) {
    errorCollect += &quot;【get_Incurrency 提取失败】实际值：[&quot; + actInCurrency + &quot;]\n&quot;;
}

// ----------------------预期值检查----------------------

if (expTotal.length() == 0) {
    errorCollect += &quot;【total 预期值为空】无法断言 get_total\n&quot;;
}

if (expDebitAmountUsd.length() == 0) {
    errorCollect += &quot;【金额预期值为空】无法断言 debitAmountUsd\n&quot;;
}

if (expCreditAmountUsd.length() == 0) {
    errorCollect += &quot;【金额预期值为空】无法断言 creditAmountUsd\n&quot;;
}

if (expOutTradingAccount.length() == 0) {
    errorCollect += &quot;【转出账户预期值为空】无法断言 OuttradingAccount\n&quot;;
}

if (expInTradingAccount.length() == 0) {
    errorCollect += &quot;【转入账户预期值为空】无法断言 IntradingAccount；请检查 account 或 userId 是否有值\n&quot;;
}

// expOutCurrency / expInCurrency 允许为空，所以这里不做 length == 0 失败判断

// ----------------------1. get_total = 2----------------------

if (!isExtractFail(actTotal)) {
    if (!numberEquals(expTotal, actTotal)) {
        errorCollect += &quot;【get_total 断言失败】预期：[&quot; + expTotal + &quot;]，实际 get_total：[&quot; + actTotal + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_total 断言通过】预期：[&quot; + expTotal + &quot;]，实际 get_total：[&quot; + actTotal + &quot;]\n&quot;;
    }
}

// ----------------------2. debitAmountUsd = 0.5----------------------

if (expDebitAmountUsd.length() &gt; 0 &amp;&amp; !isExtractFail(actDebitAmountUsd)) {
    if (!numberEquals(expDebitAmountUsd, actDebitAmountUsd)) {
        errorCollect += &quot;【debitAmountUsd 断言失败】预期：[&quot; + expDebitAmountUsd + &quot;]，实际 debitAmountUsd：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【debitAmountUsd 断言通过】预期：[&quot; + expDebitAmountUsd + &quot;]，实际 debitAmountUsd：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
    }
}

// ----------------------3. creditAmountUsd = 0.5----------------------

if (expCreditAmountUsd.length() &gt; 0 &amp;&amp; !isExtractFail(actCreditAmountUsd)) {
    if (!numberEquals(expCreditAmountUsd, actCreditAmountUsd)) {
        errorCollect += &quot;【creditAmountUsd 断言失败】预期：[&quot; + expCreditAmountUsd + &quot;]，实际 creditAmountUsd：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【creditAmountUsd 断言通过】预期：[&quot; + expCreditAmountUsd + &quot;]，实际 creditAmountUsd：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
    }
}

// ----------------------4. OuttradingAccount = Commission Wallet----------------------

String expOutTradingAccountClean = normalizeTradingAccount(expOutTradingAccount);
String actOutTradingAccountClean = normalizeTradingAccount(actOutTradingAccount);

if (expOutTradingAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actOutTradingAccount)) {
    if (!expOutTradingAccountClean.equals(actOutTradingAccountClean)) {
        errorCollect += &quot;【OuttradingAccount 断言失败】&quot;
            + &quot;预期原始值：[&quot; + expOutTradingAccount + &quot;]，&quot;
            + &quot;预期解析值：[&quot; + expOutTradingAccountClean + &quot;]，&quot;
            + &quot;实际原始值：[&quot; + actOutTradingAccount + &quot;]，&quot;
            + &quot;实际解析值：[&quot; + actOutTradingAccountClean + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【OuttradingAccount 断言通过】&quot;
            + &quot;预期原始值：[&quot; + expOutTradingAccount + &quot;]，&quot;
            + &quot;实际原始值：[&quot; + actOutTradingAccount + &quot;]，&quot;
            + &quot;解析值：[&quot; + actOutTradingAccountClean + &quot;]\n&quot;;
    }
}

// ----------------------5. IntradingAccount = 用户钱包账号----------------------

String expInTradingAccountClean = normalizeTradingAccount(expInTradingAccount);
String actInTradingAccountClean = normalizeTradingAccount(actInTradingAccount);

if (expInTradingAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actInTradingAccount)) {
    if (!expInTradingAccountClean.equals(actInTradingAccountClean)) {
        errorCollect += &quot;【IntradingAccount 断言失败】&quot;
            + &quot;预期原始值：[&quot; + expInTradingAccount + &quot;]，&quot;
            + &quot;预期解析值：[&quot; + expInTradingAccountClean + &quot;]，&quot;
            + &quot;实际原始值：[&quot; + actInTradingAccount + &quot;]，&quot;
            + &quot;实际解析值：[&quot; + actInTradingAccountClean + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【IntradingAccount 断言通过】&quot;
            + &quot;预期原始值：[&quot; + expInTradingAccount + &quot;]，&quot;
            + &quot;实际原始值：[&quot; + actInTradingAccount + &quot;]，&quot;
            + &quot;解析值：[&quot; + actInTradingAccountClean + &quot;]\n&quot;;
    }
}

// ----------------------6. get_Outcurrency = 空字符串----------------------

if (!isExtractFailAllowEmpty(actOutCurrency)) {
    if (!expOutCurrency.equals(actOutCurrency)) {
        errorCollect += &quot;【get_Outcurrency 断言失败】预期：[&quot; + expOutCurrency + &quot;]，实际 get_Outcurrency：[&quot; + actOutCurrency + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_Outcurrency 断言通过】预期：[&quot; + expOutCurrency + &quot;]，实际 get_Outcurrency：[&quot; + actOutCurrency + &quot;]\n&quot;;
    }
}

// ----------------------7. get_Incurrency = 空字符串----------------------

if (!isExtractFailAllowEmpty(actInCurrency)) {
    if (!expInCurrency.equals(actInCurrency)) {
        errorCollect += &quot;【get_Incurrency 断言失败】预期：[&quot; + expInCurrency + &quot;]，实际 get_Incurrency：[&quot; + actInCurrency + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_Incurrency 断言通过】预期：[&quot; + expInCurrency + &quot;]，实际 get_Incurrency：[&quot; + actInCurrency + &quot;]\n&quot;;
    }
}

// ----------------------统一补充检查明细----------------------

passCollect += &quot;【检查】get_total = 2，预期：[&quot; + expTotal + &quot;]，实际：[&quot; + actTotal + &quot;]\n&quot;;
passCollect += &quot;【检查】debitAmountUsd，预期：[&quot; + expDebitAmountUsd + &quot;]，实际：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
passCollect += &quot;【检查】creditAmountUsd，预期：[&quot; + expCreditAmountUsd + &quot;]，实际：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
passCollect += &quot;【检查】OuttradingAccount，预期原始值：[&quot; + expOutTradingAccount + &quot;]，预期解析值：[&quot; + expOutTradingAccountClean + &quot;]，实际原始值：[&quot; + actOutTradingAccount + &quot;]，实际解析值：[&quot; + actOutTradingAccountClean + &quot;]\n&quot;;
passCollect += &quot;【检查】IntradingAccount，预期原始值：[&quot; + expInTradingAccount + &quot;]，预期解析值：[&quot; + expInTradingAccountClean + &quot;]，实际原始值：[&quot; + actInTradingAccount + &quot;]，实际解析值：[&quot; + actInTradingAccountClean + &quot;]\n&quot;;
passCollect += &quot;【检查】get_Outcurrency，预期：[&quot; + expOutCurrency + &quot;]，实际：[&quot; + actOutCurrency + &quot;]\n&quot;;
passCollect += &quot;【检查】get_Incurrency，预期：[&quot; + expInCurrency + &quot;]，实际：[&quot; + actInCurrency + &quot;]\n&quot;;

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言检查明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 输出到 jmeter.log
log.info(finalMessage);

// 保存到 JMeter 变量，可用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 写入当前请求 Response Message，可在察看结果树查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 设置断言结果
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}</stringProp>
              </JSR223Assertion>
