              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取首页 balance" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">account_list_balance</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.accountId == ${tradingAccount_cj})].balance</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="TestPlan.comments">${tradingAccount_rj}</stringProp>
