            <stringProp name="script">// 直接使用JMeter内置的循环索引，0 = 第一次循环，1 = 第二次循环
String idxStr = vars.get(&quot;__jm__MT account forget__idx&quot;);
int count = (idxStr == null || idxStr.isEmpty()) ? 0 : Integer.parseInt(idxStr);

if (count == 0) {
    vars.put(&quot;id&quot;, vars.get(&quot;forget_email_41&quot;));
} else {
    vars.put(&quot;id&quot;, vars.get(&quot;forget_email_51&quot;));
}
</stringProp>
