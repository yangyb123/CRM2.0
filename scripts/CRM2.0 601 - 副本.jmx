              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="清洗金额字段" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;
import org.junit.Assert;

String extractNumber(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    Pattern p = Pattern.compile(&quot;-?\\d+(\\.\\d+)?&quot;);
    Matcher m = p.matcher(value);

    if (m.find()) {
        return m.group(0);
    }

    return &quot;&quot;;
}

// 读取原始提取值
String transferAmountRaw = vars.get(&quot;get_transferAmount&quot;);

// 提取纯数字
String transferAmountClean = extractNumber(transferAmountRaw);

// 覆盖原变量
vars.put(&quot;get_transferAmount&quot;, transferAmountClean);

// 保留原始值，方便调试
vars.put(&quot;get_transferAmount_raw&quot;, transferAmountRaw == null ? &quot;&quot; : transferAmountRaw);

// ========== 新增断言校验逻辑 ==========

try {
    Assert.assertEquals(&quot;转账金额校验失败&quot;, expectStr, transferAmountClean);
    log.info(&quot;金额校验通过，清洗后数值：&quot; + transferAmountClean + &quot;，原始值：&quot; + transferAmountRaw);
} catch (Exception e) {
    log.error(&quot;金额校验失败：预期[&quot; + expectStr + &quot;], 清洗后[&quot; + transferAmountClean + &quot;], 原始[&quot; + transferAmountRaw + &quot;]&quot;);
    throw e;
}</stringProp>
                <stringProp name="TestPlan.comments">去掉单位</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    // 去掉常见不可见字符
    value = value.replace(&quot;\uFEFF&quot;, &quot;&quot;);
    value = value.replace(&quot;\u200B&quot;, &quot;&quot;);
    value = value.replace(&quot;\u00A0&quot;, &quot;&quot;);

    // 兼容 JSON 提取器偶尔取到 [&quot;xxx&quot;] 的情况
    if (value.startsWith(&quot;[&quot;) &amp;&amp; value.endsWith(&quot;]&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1).trim();
    }

    // 兼容取到 &quot;xxx&quot; 的情况
    if (value.startsWith(&quot;\&quot;&quot;) &amp;&amp; value.endsWith(&quot;\&quot;&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1).trim();
    }

    return value.trim();
}

String getVar(String name) {
    return clean(vars.get(name));
}

boolean isExtractFail(String value) {
    String text = clean(value);

    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// 处理账号格式：
// User wallet (U7LCYE) -&gt; U7LCYE
// User Wallet (U7LCYE) -&gt; U7LCYE
// MT Account (880027) -&gt; 880027
// 如果没有括号，则原样返回
String normalizeAccount(String value) {
    String text = clean(value);

    int left = text.lastIndexOf(&quot;(&quot;);
    int right = text.lastIndexOf(&quot;)&quot;);

    if (left &gt;= 0 &amp;&amp; right &gt; left) {
        return clean(text.substring(left + 1, right));
    }

    return text;
}

// ----------------------读取实际提取值----------------------

String actAccountNo = getVar(&quot;get_accountNo&quot;);
String actToAccount = getVar(&quot;get_toAccount&quot;);
String actTransferType = getVar(&quot;get_transferType&quot;);
String actTransferAmount = getVar(&quot;get_transferAmount&quot;);
String actAmount = getVar(&quot;get_amount&quot;);
String actStatus = getVar(&quot;get_status&quot;);

// ----------------------读取预期值----------------------

// 用户钱包转给 MT 账号，转出账号来自 Walletaccount
String expAccountNo = getVar(&quot;Walletaccount&quot;);

// 转入 MT 账号来自 toAccountym
String expToAccount = getVar(&quot;toAccountym&quot;);

// 当前脚本里原来写的是固定 2，这里保留这个逻辑
// 如果你后续要从 CSV 的 type 字段取值，把这一行改成：String expTransferType = getVar(&quot;type&quot;);
String expTransferType = &quot;2&quot;;

// 用户钱包转 MT 的订单查询里，金额按 amountUSD 对比
String expTransferAmount = getVar(&quot;amountUSD&quot;);
String expAmount = getVar(&quot;amountUSD&quot;);

// 订单状态按 audit_type 对比
String expStatus = getVar(&quot;audit_type&quot;);

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;

// ----------------------提取值检查----------------------

if (isExtractFail(actAccountNo)) {
    errorCollect += &quot;【get_accountNo 提取失败】实际值：[&quot; + actAccountNo + &quot;]\n&quot;;
}

if (isExtractFail(actToAccount)) {
    errorCollect += &quot;【get_toAccount 提取失败】实际值：[&quot; + actToAccount + &quot;]\n&quot;;
}

if (isExtractFail(actTransferType)) {
    errorCollect += &quot;【get_transferType 提取失败】实际值：[&quot; + actTransferType + &quot;]\n&quot;;
}

if (isExtractFail(actTransferAmount)) {
    errorCollect += &quot;【get_transferAmount 提取失败】实际值：[&quot; + actTransferAmount + &quot;]\n&quot;;
}

if (isExtractFail(actAmount)) {
    errorCollect += &quot;【get_amount 提取失败】实际值：[&quot; + actAmount + &quot;]\n&quot;;
}

if (isExtractFail(actStatus)) {
    errorCollect += &quot;【get_status 提取失败】实际值：[&quot; + actStatus + &quot;]\n&quot;;
}

// ----------------------预期值检查----------------------

if (expAccountNo.length() == 0) {
    errorCollect += &quot;【Walletaccount 预期变量为空】无法断言 get_accountNo\n&quot;;
}

if (expToAccount.length() == 0) {
    errorCollect += &quot;【toAccountym 预期变量为空】无法断言 get_toAccount\n&quot;;
}

if (expTransferType.length() == 0) {
    errorCollect += &quot;【transferType 预期值为空】无法断言 get_transferType\n&quot;;
}

if (expTransferAmount.length() == 0) {
    errorCollect += &quot;【amountUSD 预期变量为空】无法断言 get_transferAmount\n&quot;;
}

if (expAmount.length() == 0) {
    errorCollect += &quot;【amountUSD 预期变量为空】无法断言 get_amount\n&quot;;
}

if (expStatus.length() == 0) {
    errorCollect += &quot;【audit_type 预期变量为空】无法断言 get_status\n&quot;;
}

// ----------------------1. get_accountNo = Walletaccount----------------------

String expAccountNoClean = normalizeAccount(expAccountNo);
String actAccountNoClean = normalizeAccount(actAccountNo);

if (expAccountNo.length() &gt; 0 &amp;&amp; !isExtractFail(actAccountNo)) {
    if (!expAccountNoClean.equals(actAccountNoClean)) {
        errorCollect += &quot;【get_accountNo 断言失败】&quot;
            + &quot;预期 Walletaccount：[&quot; + expAccountNo + &quot;]，&quot;
            + &quot;预期解析账号：[&quot; + expAccountNoClean + &quot;]，&quot;
            + &quot;实际 get_accountNo：[&quot; + actAccountNo + &quot;]，&quot;
            + &quot;实际解析账号：[&quot; + actAccountNoClean + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_accountNo 断言通过】&quot;
            + &quot;预期 Walletaccount：[&quot; + expAccountNo + &quot;]，&quot;
            + &quot;实际 get_accountNo：[&quot; + actAccountNo + &quot;]，&quot;
            + &quot;解析后账号：[&quot; + actAccountNoClean + &quot;]\n&quot;;
    }
}

// ----------------------2. get_toAccount = toAccountym----------------------

String expToAccountClean = normalizeAccount(expToAccount);
String actToAccountClean = normalizeAccount(actToAccount);

if (expToAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actToAccount)) {
    if (!expToAccountClean.equals(actToAccountClean)) {
        errorCollect += &quot;【get_toAccount 断言失败】&quot;
            + &quot;预期 toAccountym：[&quot; + expToAccount + &quot;]，&quot;
            + &quot;预期解析账号：[&quot; + expToAccountClean + &quot;]，&quot;
            + &quot;实际 get_toAccount：[&quot; + actToAccount + &quot;]，&quot;
            + &quot;实际解析账号：[&quot; + actToAccountClean + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_toAccount 断言通过】&quot;
            + &quot;预期 toAccountym：[&quot; + expToAccount + &quot;]，&quot;
            + &quot;实际 get_toAccount：[&quot; + actToAccount + &quot;]，&quot;
            + &quot;解析后账号：[&quot; + actToAccountClean + &quot;]\n&quot;;
    }
}

// ----------------------3. get_transferType = 2----------------------

if (!isExtractFail(actTransferType)) {
    if (!expTransferType.equals(actTransferType)) {
        errorCollect += &quot;【get_transferType 断言失败】&quot;
            + &quot;预期：[&quot; + expTransferType + &quot;]，&quot;
            + &quot;实际 get_transferType：[&quot; + actTransferType + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_transferType 断言通过】&quot;
            + &quot;预期：[&quot; + expTransferType + &quot;]，&quot;
            + &quot;实际 get_transferType：[&quot; + actTransferType + &quot;]\n&quot;;
    }
}

// ----------------------4. get_transferAmount = amountUSD----------------------

if (expTransferAmount.length() &gt; 0 &amp;&amp; !isExtractFail(actTransferAmount)) {
    if (!numberEquals(expTransferAmount, actTransferAmount)) {
        errorCollect += &quot;【get_transferAmount 断言失败】&quot;
            + &quot;预期 amountUSD：[&quot; + expTransferAmount + &quot;]，&quot;
            + &quot;实际 get_transferAmount：[&quot; + actTransferAmount + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_transferAmount 断言通过】&quot;
            + &quot;预期 amountUSD：[&quot; + expTransferAmount + &quot;]，&quot;
            + &quot;实际 get_transferAmount：[&quot; + actTransferAmount + &quot;]\n&quot;;
    }
}

// ----------------------5. get_amount = amountUSD----------------------

if (expAmount.length() &gt; 0 &amp;&amp; !isExtractFail(actAmount)) {
    if (!numberEquals(expAmount, actAmount)) {
        errorCollect += &quot;【get_amount 断言失败】&quot;
            + &quot;预期 amountUSD：[&quot; + expAmount + &quot;]，&quot;
            + &quot;实际 get_amount：[&quot; + actAmount + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_amount 断言通过】&quot;
            + &quot;预期 amountUSD：[&quot; + expAmount + &quot;]，&quot;
            + &quot;实际 get_amount：[&quot; + actAmount + &quot;]\n&quot;;
    }
}

// ----------------------6. get_status = audit_type----------------------

if (!isExtractFail(actStatus)) {
    if (!expStatus.equals(actStatus)) {
        errorCollect += &quot;【get_status 断言失败】&quot;
            + &quot;预期 audit_type：[&quot; + expStatus + &quot;]，&quot;
            + &quot;实际 get_status：[&quot; + actStatus + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【get_status 断言通过】&quot;
            + &quot;预期 audit_type：[&quot; + expStatus + &quot;]，&quot;
            + &quot;实际 get_status：[&quot; + actStatus + &quot;]\n&quot;;
    }
}

// ----------------------统一补充检查明细----------------------

passCollect += &quot;【检查】get_accountNo = Walletaccount，预期原始值：[&quot; + expAccountNo + &quot;]，预期解析值：[&quot; + expAccountNoClean + &quot;]，实际原始值：[&quot; + actAccountNo + &quot;]，实际解析值：[&quot; + actAccountNoClean + &quot;]\n&quot;;
passCollect += &quot;【检查】get_toAccount = toAccountym，预期原始值：[&quot; + expToAccount + &quot;]，预期解析值：[&quot; + expToAccountClean + &quot;]，实际原始值：[&quot; + actToAccount + &quot;]，实际解析值：[&quot; + actToAccountClean + &quot;]\n&quot;;
passCollect += &quot;【检查】get_transferType，预期：[&quot; + expTransferType + &quot;]，实际：[&quot; + actTransferType + &quot;]\n&quot;;
passCollect += &quot;【检查】get_transferAmount = amountUSD，预期：[&quot; + expTransferAmount + &quot;]，实际：[&quot; + actTransferAmount + &quot;]\n&quot;;
passCollect += &quot;【检查】get_amount = amountUSD，预期：[&quot; + expAmount + &quot;]，实际：[&quot; + actAmount + &quot;]\n&quot;;
passCollect += &quot;【检查】get_status = audit_type，预期：[&quot; + expStatus + &quot;]，实际：[&quot; + actStatus + &quot;]\n&quot;;

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言检查明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 1. 输出到 jmeter.log
log.info(finalMessage);

// 2. 保存到 JMeter 变量，可用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 3. 写入当前请求 Response Message，可在察看结果树查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 4. 设置断言结果
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}</stringProp>
              </JSR223Assertion>
