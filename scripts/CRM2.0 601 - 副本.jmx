            <hashTree>
              <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="生成随机邮箱" enabled="true">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">import java.util.Random;

// 生成随机手机号（第一位固定是 1）
Random random = new Random();

// 第二位：3,4,5,7,8 选一个（手机号规范号段）
int[] second = {3,4,5,7,8};
int sec = second[random.nextInt(second.length)];

// 后面9位随机数字
StringBuilder sb = new StringBuilder();
sb.append(&quot;1&quot;);          // 第1位固定 1
sb.append(sec);          // 第2位合法号段
for (int i=0; i&lt;9; i++){
    sb.append(random.nextInt(10));
}

// 存入变量，名称：mobile
String mobile = sb.toString();
vars.put(&quot;mobile&quot;, mobile);

// 日志打印（可选）
log.info(&quot;生成随机手机号：&quot; + mobile);</stringProp>
                <stringProp name="TestPlan.comments">生成随机邮箱</stringProp>
              </BeanShellPreProcessor>
              <hashTree/>
            </hashTree>
