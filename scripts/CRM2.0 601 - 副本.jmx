                  <stringProp name="JSONPostProcessor.referenceNames">get_Outcurrency</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer Out&quot;)].currency</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取Incurrency" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">get_Incurrency</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer In&quot;)].currency</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
