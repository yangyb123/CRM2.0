                  <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

String extractNumber(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    Pattern p = Pattern.compile(&quot;-?\\d+(\\.\\d+)?&quot;);
    Matcher m = p.matcher(value);

    if (m.find()) {
        return m.group(0);
    }

    return &quot;&quot;;
}

// 读取原始提取值
String depositAmountRaw = vars.get(&quot;get_depositAmount&quot;);
String submitAmountRaw = vars.get(&quot;get_submitAmount&quot;);

// 提取纯数字
String depositAmountClean = extractNumber(depositAmountRaw);
String submitAmountClean = extractNumber(submitAmountRaw);

// 覆盖原变量
vars.put(&quot;get_depositAmount&quot;, depositAmountClean);
vars.put(&quot;get_submitAmount&quot;, submitAmountClean);

// 可选：保留原始值，方便调试
vars.put(&quot;get_depositAmount_raw&quot;, depositAmountRaw == null ? &quot;&quot; : depositAmountRaw);
vars.put(&quot;get_submitAmount_raw&quot;, submitAmountRaw == null ? &quot;&quot; : submitAmountRaw);</stringProp>
