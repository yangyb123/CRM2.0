          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="生成随机密码" enabled="true">
            <stringProp name="BeanShellSampler.query">import java.util.Random;

Random rnd = new Random();
String lower   = &quot;abcdefghijklmnopqrstuvwxyz&quot;;
String upper   = &quot;ABCDEFGHIJKLMNOPQRSTUVWXYZ&quot;;
String digit   = &quot;0123456789&quot;;
String special = &quot;#[]@$&amp;*!?|^+-_&quot;;
String allChar = lower + upper + digit + special;

int minLen = 8, maxLen = 16;
int totalLen = rnd.nextInt(maxLen - minLen + 1) + minLen;

char cLower   = lower.charAt(rnd.nextInt(lower.length()));
char cUpper   = upper.charAt(rnd.nextInt(upper.length()));
char cDigit   = digit.charAt(rnd.nextInt(digit.length()));
char cSpecial = special.charAt(rnd.nextInt(special.length()));

StringBuilder pwd = new StringBuilder();
pwd.append(cLower).append(cUpper).append(cDigit).append(cSpecial);
for (int i = 0; i &lt; totalLen - 4; i++) {
    pwd.append(allChar.charAt(rnd.nextInt(allChar.length())));
}

// Fisher-Yates 洗牌
char[] arr = pwd.toString().toCharArray();
for (int i = arr.length - 1; i &gt; 0; i--) {
    int j = rnd.nextInt(i + 1);
    char tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
}

vars.put(&quot;newPassword&quot;, new String(arr));
log.info(&quot;新密码已生成：&quot; + vars.get(&quot;newPassword&quot;));

</stringProp>
          </BeanShellSampler>
