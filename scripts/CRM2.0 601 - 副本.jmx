              <stringProp name="script">// 获取两个变量的值
String var1 = vars.get(&quot;admin_history_cmd51&quot;);
String var2 = vars.get(&quot;MT5_cmd&quot;);

// 空值判断
if (var1 == null || var2 == null) {
    Failure = true;
    FailureMessage = &quot;变量为空：admin_history_cmd51=&quot; + var1 + &quot;, MT5_cmd=&quot; + var2;
    return;
}

// 比较两个变量是否相等
if (!var1.equals(var2)) {
    Failure = true;
    FailureMessage = &quot;两个变量值不一致！\nadmin_history_cmd51: &quot; + var1 + &quot;\nMT5_cmd: &quot; + var2;
} else {
    log.info(&quot;✅ 变量校验通过：admin_history_cmd51 和 MT5_cmd 值均为 &quot; + var1);
}</stringProp>
