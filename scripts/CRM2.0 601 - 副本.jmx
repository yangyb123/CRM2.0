            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="判断MT5返佣金额" enabled="true">
              <stringProp name="BeanShellAssertion.query">import java.math.BigDecimal;

String lotStr = vars.get(&quot;volume51&quot;);
String commStr = vars.get(&quot;rebate_logs51&quot;);
String orderId = vars.get(&quot;mt5_order_id&quot;);

if (lotStr == null) {
    lotStr = &quot;&quot;;
}

if (commStr == null) {
    commStr = &quot;&quot;;
}

if (orderId == null) {
    orderId = &quot;&quot;;
}

lotStr = lotStr.trim();
commStr = commStr.trim();
orderId = orderId.trim();

// 兼容 JSON 提取器返回 [&quot;0.5600&quot;] 这种格式
commStr = commStr.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();

String msg = &quot;&quot;;

try {
    if (lotStr.length() == 0 || &quot;NOT_FOUND&quot;.equals(lotStr) || &quot;NOT FOUND&quot;.equals(lotStr)) {
        msg = &quot;MT5返佣金额断言失败：volume51 未提取到，&quot;
            + &quot;mt5_order_id=[&quot; + orderId + &quot;]，&quot;
            + &quot;volume51=[&quot; + lotStr + &quot;]，&quot;
            + &quot;rebate_logs51=[&quot; + commStr + &quot;]&quot;;

        Failure = true;
        FailureMessage = msg;

        prev.setSuccessful(false);
        prev.setResponseCode(&quot;500&quot;);
        prev.setResponseMessage(msg);

        log.error(msg);
    } else if (commStr.length() == 0 || &quot;NOT_FOUND&quot;.equals(commStr) || &quot;NOT FOUND&quot;.equals(commStr)) {
        msg = &quot;MT5返佣金额断言失败：rebate_logs51 未提取到，&quot;
            + &quot;请检查 JSONPath 是否按 mt5_order_id 正确过滤，&quot;
            + &quot;mt5_order_id=[&quot; + orderId + &quot;]，&quot;
            + &quot;volume51=[&quot; + lotStr + &quot;]，&quot;
            + &quot;rebate_logs51=[&quot; + commStr + &quot;]&quot;;

        Failure = true;
        FailureMessage = msg;

        prev.setSuccessful(false);
        prev.setResponseCode(&quot;500&quot;);
        prev.setResponseMessage(msg);

        log.error(msg);
    } else {
        BigDecimal lot = new BigDecimal(lotStr);
        BigDecimal rate = new BigDecimal(&quot;28&quot;);
        BigDecimal expected = lot.multiply(rate);
        BigDecimal actual = new BigDecimal(commStr);

        String expectedText = expected.stripTrailingZeros().toPlainString();
        String actualText = actual.stripTrailingZeros().toPlainString();

        msg = &quot;MT5返佣金额断言：&quot;
            + &quot;mt5_order_id=[&quot; + orderId + &quot;]，&quot;
            + &quot;volume51=[&quot; + lotStr + &quot;]，&quot;
            + &quot;返佣参数=[28]，&quot;
            + &quot;预期返佣金额=volume51*28=[&quot; + expectedText + &quot;]，&quot;
            + &quot;实际返佣金额rebate_logs51=[&quot; + actualText + &quot;]&quot;;

        if (actual.compareTo(expected) == 0) {
            Failure = false;

            prev.setSuccessful(true);
            prev.setResponseCode(&quot;200&quot;);
            prev.setResponseMessage(&quot;断言通过：&quot; + msg);

            log.info(&quot;断言通过：&quot; + msg);

            vars.put(&quot;expectRebate51&quot;, expectedText);
            vars.put(&quot;actualRebate51&quot;, actualText);
            vars.put(&quot;MT5_rebate_assert_detail&quot;, &quot;断言通过：&quot; + msg);
        } else {
            Failure = true;
            FailureMessage = &quot;断言失败：&quot; + msg;

            prev.setSuccessful(false);
            prev.setResponseCode(&quot;500&quot;);
            prev.setResponseMessage(&quot;断言失败：&quot; + msg);

            log.error(&quot;断言失败：&quot; + msg);

            vars.put(&quot;expectRebate51&quot;, expectedText);
            vars.put(&quot;actualRebate51&quot;, actualText);
            vars.put(&quot;MT5_rebate_assert_detail&quot;, &quot;断言失败：&quot; + msg);
        }
    }
} catch (Exception e) {
    msg = &quot;MT5返佣金额断言异常：&quot;
        + &quot;mt5_order_id=[&quot; + orderId + &quot;]，&quot;
        + &quot;volume51=[&quot; + lotStr + &quot;]，&quot;
        + &quot;rebate_logs51=[&quot; + commStr + &quot;]，&quot;
        + &quot;异常信息=[&quot; + e.getMessage() + &quot;]&quot;;

    Failure = true;
    FailureMessage = msg;

    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(msg);

    log.error(msg);

    vars.put(&quot;MT5_rebate_assert_detail&quot;, msg);
}</stringProp>
