              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取toCurrency" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">get_toCurrency</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.id == ${order_id})].toCurrency</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
