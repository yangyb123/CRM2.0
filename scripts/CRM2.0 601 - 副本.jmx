              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// 读取JMeter变量
String expAccount = vars.get(&quot;account&quot;);
String actAccount = vars.get(&quot;get_account&quot;);

String expAmount = vars.get(&quot;amountUSD&quot;);
String actAmount = vars.get(&quot;get_amountUsd&quot;);

String expPay = vars.get(&quot;paymentMethod&quot;);
String actPay = vars.get(&quot;get_paymentMethod&quot;);

int expStatus = 0; 
int actStatus = -1;

String allError = &quot;&quot;; // 存储全部错误信息

// 空值兜底，避免null.equals()抛异常
if(expAccount == null) expAccount = &quot;&quot;;
if(actAccount == null) actAccount = &quot;&quot;;
if(expAmount == null) expAmount = &quot;&quot;;
if(actAmount == null) actAmount = &quot;&quot;;
if(expPay == null) expPay = &quot;&quot;;
if(actPay == null) actPay = &quot;&quot;;

// 去掉前后空格
expAccount = expAccount.trim();
actAccount = actAccount.trim();
expAmount = expAmount.trim();
actAmount = actAmount.trim();
expPay = expPay.trim();
actPay = actPay.trim();

// 处理get_status数字转换异常
try{
    String statusText = vars.get(&quot;get_status&quot;);
    if(statusText == null || statusText.trim().length() == 0){
        throw new Exception(&quot;变量get_status为空&quot;);
    }
    actStatus = Integer.parseInt(statusText.trim());
}catch(Exception e){
    allError += &quot;【订单状态 转换异常】原因：&quot; + e.getMessage() + &quot;\n&quot;;
}

// 1. 校验账户
if (!expAccount.equals(actAccount)){
    allError += &quot;【账户 断言失败】预期：&quot; + expAccount + &quot;，实际：&quot; + actAccount + &quot;\n&quot;;
}

// 2. 校验金额
if (!expAmount.equals(actAmount)){
    allError += &quot;【金额 断言失败】预期：&quot; + expAmount + &quot;，实际：&quot; + actAmount + &quot;\n&quot;;
}

// 3. 校验支付方式
if (!expPay.equals(actPay)){
    allError += &quot;【支付方式 断言失败】预期：&quot; + expPay + &quot;，实际：&quot; + actPay + &quot;\n&quot;;
}

// 4. 校验状态码
if (actStatus != expStatus){
    allError += &quot;【订单状态 断言失败】预期：&quot; + expStatus + &quot;，实际：&quot; + actStatus + &quot;\n&quot;;
}

// 全部校验完成，统一判断是否存在错误
if(allError.length() &gt; 0){
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;多条断言校验失败汇总：\n&quot; + allError);
} else {
    AssertionResult.setFailure(false);
}</stringProp>
              </JSR223Assertion>
