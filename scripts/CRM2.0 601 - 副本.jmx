                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取Incurrency" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">get_Incurrency</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Namesake Transfer In&quot;)].currency</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    // 去掉 CSV、Excel、复制文本里可能存在的不可见字符
    value = value.replace(&quot;\uFEFF&quot;, &quot;&quot;); // BOM
    value = value.replace(&quot;\u200B&quot;, &quot;&quot;); // 零宽空格
    value = value.replace(&quot;\u00A0&quot;, &quot;&quot;); // 不间断空格

    // 兼容提取到 &quot;100.00&quot; 这种带双引号的情况
    if (value.startsWith(&quot;\&quot;&quot;) &amp;&amp; value.endsWith(&quot;\&quot;&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1);
    }

    return value.trim();
}

String getVar(String name) {
    return clean(vars.get(name));
}

// 兜底读取变量：防止 CSV 变量名误写成 amountUSD 后面带空格
String getVarWithFallback(String name1, String name2) {
    String value = clean(vars.get(name1));

    if (value.length() == 0) {
        value = clean(vars.get(name2));
    }

    return value;
}

boolean isExtractFail(String value) {
    String text = clean(value);

    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

// 允许空字符串的提取失败判断：
// 用于 fromCurrency，因为 fromCurrency 有些场景可能本身就是空字符串
boolean isExtractFailAllowEmpty(String value) {
    String text = clean(value);

    return &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// 处理 tradingAccount 返回值：
// 例如 User Wallet (U7LCYE) -&gt; U7LCYE
// 如果没有括号，则原样返回
String normalizeTradingAccount(String value) {
    String text = clean(value);

    int left = text.lastIndexOf(&quot;(&quot;);
    int right = text.lastIndexOf(&quot;)&quot;);

    if (left &gt;= 0 &amp;&amp; right &gt; left) {
        return clean(text.substring(left + 1, right));
    }

    return text;
}

// ----------------------读取实际提取值----------------------

String actTotal = getVar(&quot;get_total&quot;);
String actDebitAmountUsd = getVar(&quot;debitAmountUsd&quot;);
String actCreditAmountUsd = getVar(&quot;creditAmountUsd&quot;);
String actOutTradingAccount = getVar(&quot;OuttradingAccount&quot;);
String actInTradingAccount = getVar(&quot;IntradingAccount&quot;);
String actOutCurrency = getVar(&quot;get_Outcurrency&quot;);
String actInCurrency = getVar(&quot;get_Incurrency&quot;);

// ----------------------读取预期值----------------------

String expTotal = &quot;2&quot;;
String expDebitAmountUsd = getVar(&quot;amountUSD&quot;);
String expCreditAmountUsd = getVar(&quot;amountUSD&quot;);
String expOutTradingAccount = getVar(&quot;account&quot;);
String expInTradingAccount = getVar(&quot;toAccountwallet&quot;);
String expOutCurrency = getVar(&quot;fromCurrency&quot;);
String expInCurrency = getVar(&quot;toCurrencywallet&quot;);

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;
// ----------------------判断实际提取值是否成功----------------------

if (isExtractFail(actTotal)) {
    errorCollect += &quot;【get_total 提取失败】实际值：[&quot; + actTotal + &quot;]\n&quot;;
}

if (isExtractFail(actDebitAmountUsd)) {
    errorCollect += &quot;【debitAmountUsd 提取失败】实际值：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
}

if (isExtractFail(actOutTradingAccount)) {
    errorCollect += &quot;【OuttradingAccount 提取失败】实际值：[&quot; + actOutTradingAccount + &quot;]\n&quot;;
}

if (isExtractFail(actCreditAmountUsd)) {
    errorCollect += &quot;【creditAmountUsd 提取失败】实际值：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
}

if (isExtractFail(actInTradingAccount)) {
    errorCollect += &quot;【IntradingAccount 提取失败】实际值：[&quot; + actInTradingAccount + &quot;]\n&quot;;
}

// fromCurrency 允许业务值为空字符串，所以这里只拦截 NOT_FOUND/null
if (isExtractFailAllowEmpty(actOutCurrency)) {
    errorCollect += &quot;【get_Outcurrency 提取失败】实际值：[&quot; + actOutCurrency + &quot;]\n&quot;;
}

if (isExtractFail(actInCurrency)) {
    errorCollect += &quot;【get_Incurrency 提取失败】实际值：[&quot; + actInCurrency + &quot;]\n&quot;;
}

// ----------------------判断预期变量是否存在----------------------

if (expDebitAmountUsd.length() == 0) {
    errorCollect += &quot;【amountUSD 预期变量为空】无法断言 debitAmountUsd；请检查 CSV 变量名是否为 amountUSD\n&quot;;
}

if (expOutTradingAccount.length() == 0) {
    errorCollect += &quot;【account 预期变量为空】无法断言 OuttradingAccount\n&quot;;
}

if (expCreditAmountUsd.length() == 0) {
    errorCollect += &quot;【amountUSD 预期变量为空】无法断言 creditAmountUsd；请检查 CSV 变量名是否为 amountUSD\n&quot;;
}

if (expInTradingAccount.length() == 0) {
    errorCollect += &quot;【toAccount 预期变量为空】无法断言 IntradingAccount\n&quot;;
}

// fromCurrency 允许为空，所以这里不强制判断 expOutCurrency 为空就是失败
// 如果你的业务要求 fromCurrency 必须有值，可以打开下面这段
// if (expOutCurrency.length() == 0) {
//     errorCollect += &quot;【fromCurrency 预期变量为空】无法断言 get_Outcurrency\n&quot;;
// }

if (expInCurrency.length() == 0) {
    errorCollect += &quot;【toCurrency 预期变量为空】无法断言 get_Incurrency\n&quot;;
}

// ----------------------1. get_total = 2----------------------

if (!isExtractFail(actTotal)) {
    if (!numberEquals(expTotal, actTotal)) {
        errorCollect += &quot;【get_total 断言失败】预期：[&quot; + expTotal + &quot;]，实际 get_total：[&quot; + actTotal + &quot;]\n&quot;;
    }
}

// ----------------------2. debitAmountUsd = amountUSD----------------------

if (expDebitAmountUsd.length() &gt; 0 &amp;&amp; !isExtractFail(actDebitAmountUsd)) {
    if (!numberEquals(expDebitAmountUsd, actDebitAmountUsd)) {
        errorCollect += &quot;【debitAmountUsd 断言失败】预期 amountUSD：[&quot; + expDebitAmountUsd + &quot;]，实际 debitAmountUsd：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
    }
}

// ----------------------3. OuttradingAccount = account----------------------
// 兼容实际值为 User Wallet (xxx)、MT Account (xxx) 这种格式

if (expOutTradingAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actOutTradingAccount)) {
    String actOutTradingAccountClean = normalizeTradingAccount(actOutTradingAccount);

    if (!expOutTradingAccount.equals(actOutTradingAccountClean)) {
        errorCollect += &quot;【OuttradingAccount 断言失败】预期 account：[&quot; + expOutTradingAccount + &quot;]，实际 OuttradingAccount：[&quot; + actOutTradingAccount + &quot;]，实际解析账号：[&quot; + actOutTradingAccountClean + &quot;]\n&quot;;
    }
}

// ----------------------4. creditAmountUsd = amountUSD----------------------

if (expCreditAmountUsd.length() &gt; 0 &amp;&amp; !isExtractFail(actCreditAmountUsd)) {
    if (!numberEquals(expCreditAmountUsd, actCreditAmountUsd)) {
        errorCollect += &quot;【creditAmountUsd 断言失败】预期 amountUSD：[&quot; + expCreditAmountUsd + &quot;]，实际 creditAmountUsd：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
    }
}

// ----------------------5. IntradingAccount = toAccount----------------------
// 兼容实际值为 User Wallet (U7LCYE) 这种格式

if (expInTradingAccount.length() &gt; 0 &amp;&amp; !isExtractFail(actInTradingAccount)) {
    String actInTradingAccountClean = normalizeTradingAccount(actInTradingAccount);

    if (!expInTradingAccount.equals(actInTradingAccountClean)) {
        errorCollect += &quot;【IntradingAccount 断言失败】预期 toAccount：[&quot; + expInTradingAccount + &quot;]，实际 IntradingAccount：[&quot; + actInTradingAccount + &quot;]，实际解析账号：[&quot; + actInTradingAccountClean + &quot;]\n&quot;;
    }
}

// ----------------------6. get_Outcurrency = fromCurrency----------------------
// fromCurrency 允许空字符串参与比较，例如预期 &quot;&quot;，实际 &quot;&quot;，则通过

if (!isExtractFailAllowEmpty(actOutCurrency)) {
    if (!expOutCurrency.equals(actOutCurrency)) {
        errorCollect += &quot;【get_Outcurrency 断言失败】预期 fromCurrency：[&quot; + expOutCurrency + &quot;]，实际 get_Outcurrency：[&quot; + actOutCurrency + &quot;]\n&quot;;
    }
}

// ----------------------7. get_Incurrency = toCurrency----------------------

if (expInCurrency.length() &gt; 0 &amp;&amp; !isExtractFail(actInCurrency)) {
    if (!expInCurrency.equals(actInCurrency)) {
        errorCollect += &quot;【get_Incurrency 断言失败】预期 toCurrency：[&quot; + expInCurrency + &quot;]，实际 get_Incurrency：[&quot; + actInCurrency + &quot;]\n&quot;;
    }
}

// ----------------------收集断言检查明细----------------------

passCollect += &quot;【检查】get_total = 2，预期：[&quot; + expTotal + &quot;]，实际：[&quot; + actTotal + &quot;]\n&quot;;
passCollect += &quot;【检查】debitAmountUsd = amountUSD，预期：[&quot; + expDebitAmountUsd + &quot;]，实际：[&quot; + actDebitAmountUsd + &quot;]\n&quot;;
passCollect += &quot;【检查】creditAmountUsd = amountUSD，预期：[&quot; + expCreditAmountUsd + &quot;]，实际：[&quot; + actCreditAmountUsd + &quot;]\n&quot;;
passCollect += &quot;【检查】OuttradingAccount = account，预期：[&quot; + expOutTradingAccount + &quot;]，实际：[&quot; + actOutTradingAccount + &quot;]\n&quot;;
passCollect += &quot;【检查】IntradingAccount = toAccountwallet，预期：[&quot; + expInTradingAccount + &quot;]，实际：[&quot; + actInTradingAccount + &quot;]\n&quot;;
passCollect += &quot;【检查】get_Outcurrency = fromCurrency，预期：[&quot; + expOutCurrency + &quot;]，实际：[&quot; + actOutCurrency + &quot;]\n&quot;;
passCollect += &quot;【检查】get_Incurrency = toCurrency，预期：[&quot; + expInCurrency + &quot;]，实际：[&quot; + actInCurrency + &quot;]\n&quot;;

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言检查明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

log.info(finalMessage);
vars.put(&quot;assert_result_detail&quot;, finalMessage);

String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}

</stringProp>
                </JSR223Assertion>
                <hashTree/>
              </hashTree>
              <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="转账后余额查询" enabled="true">
                <boolProp name="TransactionController.parent">true</boolProp>
                <boolProp name="TransactionController.includeTimers">false</boolProp>
              </TransactionController>
              <hashTree>
                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="转出账号查询余额（判断转账金额正确）" enabled="true">
                  <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
                  <stringProp name="HTTPSampler.port">${port}</stringProp>
                  <stringProp name="HTTPSampler.protocol">http</stringProp>
                  <stringProp name="HTTPSampler.path">crm20/get_user_info?instanceid=${instanceid_out}&amp;login=${account}</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                  <stringProp name="HTTPSampler.method">GET</stringProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
                    <collectionProp name="Arguments.arguments"/>
                  </elementProp>
