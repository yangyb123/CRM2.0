          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 读取 JSON Extractor 提取的 mtServer 变量
def mtServer = vars.get(&quot;mtServer&quot;)

if (mtServer == &quot;MT4_live&quot;) {
    // 取用户自定义变量 mt4instanceid，赋给 instanceid
    def instId = vars.get(&quot;mt4instanceid&quot;)
    vars.put(&quot;instanceid&quot;, instId)
    log.info(&quot;mtServer = MT4_live → instanceid = &quot; + instId)
} else if (mtServer == &quot;MT5_live&quot;) {
    def instId = vars.get(&quot;mt5instanceid&quot;)
    vars.put(&quot;instanceid&quot;, instId)
    log.info(&quot;mtServer = MT5_live → instanceid = &quot; + instId)
} else {
    vars.put(&quot;instanceid&quot;, &quot;UNKNOWN&quot;)
    log.warn(&quot;mtServer 未知值: &quot; + mtServer + &quot;，instanceid 设为 UNKNOWN&quot;)
}
</stringProp>
            </JSR223PreProcessor>
