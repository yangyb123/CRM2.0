                <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="提取转账后余额" enabled="true">
                  <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                  <stringProp name="RegexExtractor.refname">to_balance_after</stringProp>
                  <stringProp name="RegexExtractor.regex">&quot;(?:b|B)alance&quot;\s*:\s*([^,}]+)</stringProp>
                  <stringProp name="RegexExtractor.template">$1$</stringProp>
                  <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
                  <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                  <stringProp name="RegexExtractor.match_number">1</stringProp>
                </RegexExtractor>
                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();
    value = value.replace(&quot;\uFEFF&quot;, &quot;&quot;);
    value = value.replace(&quot;\u200B&quot;, &quot;&quot;);
    value = value.replace(&quot;\u00A0&quot;, &quot;&quot;);

    return value.trim();
}

boolean isEmpty(String value) {
    return clean(value).length() == 0;
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// ----------------------读取变量----------------------

String beforeBalance = clean(vars.get(&quot;to_balance_before&quot;));
String afterBalance = clean(vars.get(&quot;to_balance_after&quot;));

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;

// ----------------------提取值检查----------------------

if (isEmpty(beforeBalance)) {
    errorCollect += &quot;【to_balance_before 提取失败】实际值：[&quot; + beforeBalance + &quot;]\n&quot;;
}

if (isEmpty(afterBalance)) {
    errorCollect += &quot;【to_balance_after 提取失败】实际值：[&quot; + afterBalance + &quot;]\n&quot;;
}

// ----------------------断言：to_balance_before = to_balance_after----------------------

if (!isEmpty(beforeBalance) &amp;&amp; !isEmpty(afterBalance)) {
    if (!numberEquals(beforeBalance, afterBalance)) {
        errorCollect += &quot;【余额断言失败】to_balance_before 不等于 to_balance_after，&quot;
            + &quot;to_balance_before：[&quot; + beforeBalance + &quot;]，&quot;
            + &quot;to_balance_after：[&quot; + afterBalance + &quot;]\n&quot;;
    } else {
        passCollect += &quot;【余额断言通过】to_balance_before 等于 to_balance_after，&quot;
            + &quot;to_balance_before：[&quot; + beforeBalance + &quot;]，&quot;
            + &quot;to_balance_after：[&quot; + afterBalance + &quot;]\n&quot;;
    }
}

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言通过明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 输出到 jmeter.log
log.info(finalMessage);

// 保存到 JMeter 变量，可用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 写入当前请求 Response Message，可在察看结果树查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 设置断言结果
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}</stringProp>
                </JSR223Assertion>
