            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="false">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    // 去掉常见不可见字符
    value = value.replace(&quot;\uFEFF&quot;, &quot;&quot;);
    value = value.replace(&quot;\u200B&quot;, &quot;&quot;);
    value = value.replace(&quot;\u00A0&quot;, &quot;&quot;);

    // 兼容提取到 &quot;100.00&quot; 这种带双引号的情况
    if (value.startsWith(&quot;\&quot;&quot;) &amp;&amp; value.endsWith(&quot;\&quot;&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1);
    }

    return value.trim();
}

String getVar(String name) {
    return clean(vars.get(name));
}

boolean isExtractFail(String value) {
    String text = clean(value);

    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// ----------------------读取实际值----------------------
String actAdminToAccountBalance = getVar(&quot;admin_commission_balance&quot;);

// ----------------------读取预期值----------------------
String expToBalanceafter = getVar(&quot;get_after_balance&quot;);

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;

// ----------------------判断实际提取值是否成功----------------------

if (isExtractFail(actAdminToAccountBalance)) {
    errorCollect += &quot;【admin_commission_balance 提取失败】实际值：[&quot; + actAdminToAccountBalance + &quot;]\n&quot;;
}

if (isExtractFail(expToBalanceafter)) {
    errorCollect += &quot;【get_after_balance 提取失败】实际值：[&quot; + expToBalanceafter + &quot;]\n&quot;;
}


// ----------------------1. admin_commission_balance = get_after_balance----------------------

if (!isExtractFail(actAdminToAccountBalance) &amp;&amp; !isExtractFail(expToBalanceafter)) {
    if (!numberEquals(expToBalanceafter, actAdminToAccountBalance)) {
        errorCollect += &quot;【admin_commission_balance 断言失败】预期 get_after_balance：[&quot; + expToBalanceafter + &quot;]，实际 admin_commission_balance：[&quot; + actAdminToAccountBalance + &quot;]\n&quot;;
    }
}

// ----------------------收集断言检查明细----------------------
passCollect += &quot;【检查】admin_commission_balance = get_after_balance，预期：[&quot; + actAdminToAccountBalance + &quot;]，实际：[&quot; + expToBalanceafter + &quot;]\n&quot;;

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言检查明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 1. 输出到 jmeter.log
log.info(finalMessage);

// 2. 保存到 JMeter 变量，可用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 3. 写入当前请求的 Response Message，可在察看结果树中查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 4. 控制断言成功/失败
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);

    AssertionResult.setFailureMessage(finalMessage);
}</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="持仓订单三端对比" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="判断MT5持仓订单三端是否一致" enabled="true">
            <stringProp name="scriptLanguage">beanshell</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.math.BigDecimal;

boolean hasFailure = false;

StringBuilder passMsg = new StringBuilder();
StringBuilder failMsg = new StringBuilder();

passMsg.append(&quot;========== MT5 持仓字段对比通过明细 ==========\n&quot;);
failMsg.append(&quot;========== MT5 持仓字段对比失败明细 ==========\n&quot;);


// ===================== 获取变量 =====================

String mt5_position_id = vars.get(&quot;mt5_position_id&quot;);
String MT5_cmd = vars.get(&quot;MT5_cmd&quot;);
String symbol51 = vars.get(&quot;symbol51&quot;);
String volume51 = vars.get(&quot;volume51&quot;);

String client_position_orderId51 = vars.get(&quot;client_position_orderId51&quot;);
String client_position_cmd51 = vars.get(&quot;client_position_cmd51&quot;);
String client_position_Symbol51 = vars.get(&quot;client_position_Symbol51&quot;);
String client_position_Volume51 = vars.get(&quot;client_position_Volume51&quot;);

String admin_position_orderId51 = vars.get(&quot;admin_position_orderId51&quot;);
String admin_position_cmd51 = vars.get(&quot;admin_position_cmd51&quot;);
String admin_position_Symbol51 = vars.get(&quot;admin_position_Symbol51&quot;);
String admin_position_Volume51 = vars.get(&quot;admin_position_Volume51&quot;);


// ===================== 工具方法 =====================

boolean eq(String a, String b) {
    return String.valueOf(a).trim().equals(String.valueOf(b).trim());
}

boolean numEq(String a, String b) {
    try {
        BigDecimal n1 = new BigDecimal(String.valueOf(a).trim());
        BigDecimal n2 = new BigDecimal(String.valueOf(b).trim());
        return n1.compareTo(n2) == 0;
    } catch (Exception e) {
        return eq(a, b);
    }
}

void check(boolean condition, String fieldName, String detail) {
    if (condition) {
        passMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比通过：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    } else {
        hasFailure = true;
        failMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比失败：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    }
}


// ===================== 断言逻辑 =====================

check(
    eq(client_position_orderId51, admin_position_orderId51)
        &amp;&amp; eq(admin_position_orderId51, mt5_position_id),
    &quot;订单号 orderId&quot;,
    &quot;client_position_orderId51=[&quot; + client_position_orderId51 + &quot;]，&quot;
        + &quot;admin_position_orderId51=[&quot; + admin_position_orderId51 + &quot;]，&quot;
        + &quot;mt5_position_id=[&quot; + mt5_position_id + &quot;]&quot;
);

check(
    eq(client_position_cmd51, admin_position_cmd51)
        &amp;&amp; eq(admin_position_cmd51, MT5_cmd),
    &quot;交易方向 cmd&quot;,
    &quot;client_position_cmd51=[&quot; + client_position_cmd51 + &quot;]，&quot;
        + &quot;admin_position_cmd51=[&quot; + admin_position_cmd51 + &quot;]，&quot;
        + &quot;MT5_cmd=[&quot; + MT5_cmd + &quot;]&quot;
);

check(
    eq(client_position_Symbol51, admin_position_Symbol51)
        &amp;&amp; eq(admin_position_Symbol51, symbol51),
    &quot;品种 symbol&quot;,
    &quot;client_position_Symbol51=[&quot; + client_position_Symbol51 + &quot;]，&quot;
        + &quot;admin_position_Symbol51=[&quot; + admin_position_Symbol51 + &quot;]，&quot;
        + &quot;symbol51=[&quot; + symbol51 + &quot;]&quot;
);

check(
    numEq(client_position_Volume51, admin_position_Volume51)
        &amp;&amp; numEq(admin_position_Volume51, volume51),
    &quot;手数 volume&quot;,
    &quot;client_position_Volume51=[&quot; + client_position_Volume51 + &quot;]，&quot;
        + &quot;admin_position_Volume51=[&quot; + admin_position_Volume51 + &quot;]，&quot;
        + &quot;volume51=[&quot; + volume51 + &quot;]&quot;
);


// ===================== 输出到取样器结果 =====================

String finalMsg = &quot;&quot;;

if (hasFailure) {
    finalMsg = failMsg.toString() + &quot;\n&quot; + passMsg.toString();

    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMsg);

    // 失败时显示到“查看结果树 -&gt; 取样器结果 -&gt; Response message”
    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(finalMsg);

    log.error(finalMsg);
} else {
    finalMsg = passMsg.toString();

    AssertionResult.setFailure(false);

    // 成功时也显示到“查看结果树 -&gt; 取样器结果 -&gt; Response message”
    prev.setSuccessful(true);
    prev.setResponseCode(&quot;200&quot;);
    prev.setResponseMessage(finalMsg);

    log.info(finalMsg);
}

// 存成变量，后面如果加 Debug Sampler 也能看到
vars.put(&quot;MT5_position_assert_detail&quot;, finalMsg);</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="判断MT4持仓订单三端是否一致" enabled="true">
            <stringProp name="scriptLanguage">beanshell</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.math.BigDecimal;

boolean hasFailure = false;

StringBuilder passMsg = new StringBuilder();
StringBuilder failMsg = new StringBuilder();

passMsg.append(&quot;========== MT4 持仓字段对比通过明细 ==========\n&quot;);
failMsg.append(&quot;========== MT4 持仓字段对比失败明细 ==========\n&quot;);


// ===================== 获取变量 =====================

String mt4_position_id = vars.get(&quot;mt4_position_id&quot;);
String MT4_cmd = vars.get(&quot;MT4_cmd&quot;);
String symbol41 = vars.get(&quot;symbol41&quot;);
String volume41 = vars.get(&quot;volume41&quot;);

String client_position_orderId41 = vars.get(&quot;client_position_orderId41&quot;);
String client_position_cmd41 = vars.get(&quot;client_position_cmd41&quot;);
String client_position_Symbol41 = vars.get(&quot;client_position_Symbol41&quot;);
String client_position_Volume41 = vars.get(&quot;client_position_Volume41&quot;);

String admin_position_orderId41 = vars.get(&quot;admin_position_orderId41&quot;);
String admin_position_cmd41 = vars.get(&quot;admin_position_cmd41&quot;);
String admin_position_Symbol41 = vars.get(&quot;admin_position_Symbol41&quot;);
String admin_position_Volume41 = vars.get(&quot;admin_position_Volume41&quot;);


// ===================== 工具方法 =====================

boolean eq(String a, String b) {
    return String.valueOf(a).trim().equals(String.valueOf(b).trim());
}

boolean numEq(String a, String b) {
    try {
        BigDecimal n1 = new BigDecimal(String.valueOf(a).trim());
        BigDecimal n2 = new BigDecimal(String.valueOf(b).trim());
        return n1.compareTo(n2) == 0;
    } catch (Exception e) {
        return eq(a, b);
    }
}

void check(boolean condition, String fieldName, String detail) {
    if (condition) {
        passMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比通过：&quot;).append(detail).append(&quot;\n&quot;);
    } else {
        hasFailure = true;
        failMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比失败：&quot;).append(detail).append(&quot;\n&quot;);
    }
}


// ===================== 断言逻辑 =====================

check(
    eq(client_position_orderId41, admin_position_orderId41)
        &amp;&amp; eq(admin_position_orderId41, mt4_position_id),
    &quot;订单号 orderId&quot;,
    &quot;client_position_orderId41=[&quot; + client_position_orderId41 + &quot;]，&quot;
        + &quot;admin_position_orderId41=[&quot; + admin_position_orderId41 + &quot;]，&quot;
        + &quot;mt4_position_id=[&quot; + mt4_position_id + &quot;]&quot;
);

check(
    eq(client_position_cmd41, admin_position_cmd41)
        &amp;&amp; eq(admin_position_cmd41, MT4_cmd),
    &quot;交易方向 cmd&quot;,
    &quot;client_position_cmd41=[&quot; + client_position_cmd41 + &quot;]，&quot;
        + &quot;admin_position_cmd41=[&quot; + admin_position_cmd41 + &quot;]，&quot;
        + &quot;MT4_cmd=[&quot; + MT4_cmd + &quot;]&quot;
);

check(
    eq(client_position_Symbol41, admin_position_Symbol41)
        &amp;&amp; eq(admin_position_Symbol41, symbol41),
    &quot;品种 symbol&quot;,
    &quot;client_position_Symbol41=[&quot; + client_position_Symbol41 + &quot;]，&quot;
        + &quot;admin_position_Symbol41=[&quot; + admin_position_Symbol41 + &quot;]，&quot;
        + &quot;symbol41=[&quot; + symbol41 + &quot;]&quot;
);

check(
    numEq(client_position_Volume41, admin_position_Volume41)
        &amp;&amp; numEq(admin_position_Volume41, volume41),
    &quot;手数 volume&quot;,
    &quot;client_position_Volume41=[&quot; + client_position_Volume41 + &quot;]，&quot;
        + &quot;admin_position_Volume41=[&quot; + admin_position_Volume41 + &quot;]，&quot;
        + &quot;volume41=[&quot; + volume41 + &quot;]&quot;
);


// ===================== 输出结果 =====================

if (hasFailure) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(failMsg.toString() + &quot;\n&quot; + passMsg.toString());

    log.error(failMsg.toString());
    log.info(passMsg.toString());
} else {
    AssertionResult.setFailure(false);
    log.info(passMsg.toString());
}</stringProp>
          </JSR223Assertion>
