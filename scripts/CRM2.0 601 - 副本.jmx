                  <stringProp name="script">import java.math.BigDecimal;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }
    return value.trim();
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

// ----------------------读取JMeter变量----------------------

// 1. amount
String expAmount = clean(vars.get(&quot;amount&quot;));
String actAmount = clean(vars.get(&quot;get_amount&quot;));

// 2. depositAmount
String expDepositAmount = clean(vars.get(&quot;amountUSD&quot;));
String actDepositAmount = clean(vars.get(&quot;get_depositAmount&quot;));

// 3. submitAmount
String expSubmitAmount = clean(vars.get(&quot;amountUSD&quot;));
String actSubmitAmount = clean(vars.get(&quot;get_submitAmount&quot;));

// 4. accountNo
String expAccount = clean(vars.get(&quot;account&quot;));
String actAccount = clean(vars.get(&quot;get_accountNo&quot;));

// 5. currency
String expCurrencyId = clean(vars.get(&quot;currencyId&quot;));
String actCurrencyId = clean(vars.get(&quot;get_currency&quot;));

// 6. status
String expStatus = clean(vars.get(&quot;recheck_status&quot;));
String actStatus = clean(vars.get(&quot;get_status&quot;));

String errorCollect = &quot;&quot;;

// ----------------------变量空值检查----------------------

if (expAmount.length() == 0) {
    errorCollect += &quot;【amount 变量为空】无法进行 get_amount 断言\n&quot;;
}

if (actAmount.length() == 0) {
    errorCollect += &quot;【get_amount 提取值为空】无法进行 get_amount 断言\n&quot;;
}

if (expDepositAmount.length() == 0) {
    errorCollect += &quot;【amountUSD 变量为空】无法进行 get_depositAmount 断言\n&quot;;
}

if (actDepositAmount.length() == 0) {
    errorCollect += &quot;【get_depositAmount 提取值为空】无法进行 get_depositAmount 断言\n&quot;;
}

if (expSubmitAmount.length() == 0) {
    errorCollect += &quot;【amountUSD 变量为空】无法进行 get_submitAmount 断言\n&quot;;
}

if (actSubmitAmount.length() == 0) {
    errorCollect += &quot;【get_submitAmount 提取值为空】无法进行 get_submitAmount 断言\n&quot;;
}

if (expAccount.length() == 0) {
    errorCollect += &quot;【account 变量为空】无法进行 get_accountNo 断言\n&quot;;
}

if (actAccount.length() == 0) {
    errorCollect += &quot;【get_accountNo 提取值为空】无法进行 get_accountNo 断言\n&quot;;
}

if (expCurrencyId.length() == 0) {
    errorCollect += &quot;【currencyId 变量为空】无法进行 get_currency 断言\n&quot;;
}

if (actCurrencyId.length() == 0) {
    errorCollect += &quot;【get_currency 提取值为空】无法进行 get_currency 断言\n&quot;;
}

if (expStatus.length() == 0) {
    errorCollect += &quot;【recheck_status 变量为空】无法进行 get_status 断言\n&quot;;
}

if (actStatus.length() == 0) {
    errorCollect += &quot;【get_status 提取值为空】无法进行 get_status 断言\n&quot;;
}

// ----------------------1. get_amount 数值对比----------------------

if (expAmount.length() &gt; 0 &amp;&amp; actAmount.length() &gt; 0) {
    if (!numberEquals(expAmount, actAmount)) {
        errorCollect += &quot;【get_amount 断言失败】预期文本：[&quot; + expAmount + &quot;]，实际文本：[&quot; + actAmount + &quot;]，数值不相等或无法转换\n&quot;;
    }
}

// ----------------------2. get_depositAmount 数值对比----------------------

if (expDepositAmount.length() &gt; 0 &amp;&amp; actDepositAmount.length() &gt; 0) {
    if (!numberEquals(expDepositAmount, actDepositAmount)) {
        errorCollect += &quot;【get_depositAmount 断言失败】预期文本：[&quot; + expDepositAmount + &quot;]，实际文本：[&quot; + actDepositAmount + &quot;]，数值不相等或无法转换\n&quot;;
    }
}

// ----------------------3. get_submitAmount 数值对比----------------------

if (expSubmitAmount.length() &gt; 0 &amp;&amp; actSubmitAmount.length() &gt; 0) {
    if (!numberEquals(expSubmitAmount, actSubmitAmount)) {
        errorCollect += &quot;【get_submitAmount 断言失败】预期文本：[&quot; + expSubmitAmount + &quot;]，实际文本：[&quot; + actSubmitAmount + &quot;]，数值不相等或无法转换\n&quot;;
    }
}

// ----------------------4. get_accountNo 字符串匹配----------------------

if (expAccount.length() &gt; 0 &amp;&amp; actAccount.length() &gt; 0) {
    if (!expAccount.equals(actAccount)) {
        errorCollect += &quot;【get_accountNo 断言失败】预期：[&quot; + expAccount + &quot;]，实际：[&quot; + actAccount + &quot;]\n&quot;;
    }
}

// ----------------------5. get_currency 字符串匹配----------------------

if (expCurrencyId.length() &gt; 0 &amp;&amp; actCurrencyId.length() &gt; 0) {
    if (!expCurrencyId.equals(actCurrencyId)) {
        errorCollect += &quot;【get_currency 断言失败】预期：[&quot; + expCurrencyId + &quot;]，实际：[&quot; + actCurrencyId + &quot;]\n&quot;;
    }
}

// ----------------------6. get_status 字符串匹配----------------------
// 预期值：${recheck_status}
// 实际值：${get_status}
// 注意：字符串比较必须用 equals，不能用 !=

if (expStatus.length() &gt; 0 &amp;&amp; actStatus.length() &gt; 0) {
    if (!expStatus.equals(actStatus)) {
        errorCollect += &quot;【get_status 断言失败】预期：[&quot; + expStatus + &quot;]，实际：[&quot; + actStatus + &quot;]\n&quot;;
    }
}

// ----------------------汇总所有错误，统一标记断言失败----------------------

if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(&quot;多字段断言汇总失败：\n&quot; + errorCollect);
} else {
    AssertionResult.setFailure(false);
}</stringProp>
