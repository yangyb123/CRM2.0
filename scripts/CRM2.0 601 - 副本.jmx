                <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取佣金钱包余额" enabled="true">
                  <stringProp name="HTTPSampler.domain">${ip}</stringProp>
                  <stringProp name="HTTPSampler.protocol">https</stringProp>
                  <stringProp name="HTTPSampler.path">/x/commission/wallet/info</stringProp>
                  <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                  <stringProp name="HTTPSampler.method">GET</stringProp>
                  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                  <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                  <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
                    <collectionProp name="Arguments.arguments"/>
                  </elementProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取availableBalance" enabled="true">
                    <stringProp name="JSONPostProcessor.referenceNames">get_after_balance</stringProp>
                    <stringProp name="JSONPostProcessor.jsonPathExprs">$.balance</stringProp>
                    <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                  </JSONPostProcessor>
                  <hashTree/>
                  <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                    <stringProp name="scriptLanguage">beanshell</stringProp>
                    <stringProp name="parameters"></stringProp>
                    <stringProp name="filename"></stringProp>
                    <stringProp name="cacheKey">true</stringProp>
                    <stringProp name="script">String b1 = &quot;0&quot;;
if (vars.get(&quot;get_before_balance&quot;) != null) {
    b1 = vars.get(&quot;get_before_balance&quot;);
}

String amt = &quot;0&quot;;
if (vars.get(&quot;amount&quot;) != null) {
    amt = vars.get(&quot;amountUSD&quot;);
}

String b2 = &quot;0&quot;;
if (vars.get(&quot;get_after_balance&quot;) != null) {
    b2 = vars.get(&quot;get_after_balance&quot;);
}

// 转为金额数字
double before = Double.parseDouble(b1);
double amount = Double.parseDouble(amt);
double after = Double.parseDouble(b2);

// 计算
double real = before - after;
double expect = amount;

log.info(&quot;before=&quot; + before + &quot; , after=&quot; + after);
log.info(&quot;实际差额=&quot; + real + &quot; , 预期差额=&quot; + expect);

// 精度匹配
boolean pass = Math.abs(real - expect) &lt; 0.001;

// ----------------------收集成功/失败信息----------------------

String passCollect = &quot;&quot;;
String errorCollect = &quot;&quot;;

if (pass) {
    passCollect += &quot;【余额断言通过】转出账户余额减少正确\n&quot;;
    passCollect += &quot;get_before_balance：[&quot; + b1 + &quot;]\n&quot;;
    passCollect += &quot;get_after_balance：[&quot; + b2 + &quot;]\n&quot;;
    passCollect += &quot;amount：[&quot; + amt + &quot;]\n&quot;;
    passCollect += &quot;实际减少余额 before - after：[&quot; + real + &quot;]\n&quot;;
    passCollect += &quot;期望减少余额 amount：[&quot; + expect + &quot;]\n&quot;;
} else {
    errorCollect += &quot;【余额断言失败】转出账户余额减少不正确\n&quot;;
    errorCollect += &quot;get_before_balance：[&quot; + b1 + &quot;]\n&quot;;
    errorCollect += &quot;get_after_balance：[&quot; + b2 + &quot;]\n&quot;;
    errorCollect += &quot;amount：[&quot; + amt + &quot;]\n&quot;;
    errorCollect += &quot;实际减少余额 before - after：[&quot; + real + &quot;]\n&quot;;
    errorCollect += &quot;期望减少余额 amount：[&quot; + expect + &quot;]\n&quot;;
    errorCollect += &quot;差值：[&quot; + Math.abs(real - expect) + &quot;]\n&quot;;
}

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言通过明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 1. 输出到 jmeter.log
log.info(finalMessage);

// 2. 保存到 JMeter 变量，可以用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 3. 写入当前请求的 Response Message，可以在察看结果树里查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 4. 设置断言结果
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);

    // 成功时 JMeter 的 Assertion Results 不一定展示这条，但 Response Message / log / Debug Sampler 会展示
    AssertionResult.setFailureMessage(finalMessage);
}</stringProp>
