            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.math.BigDecimal;
import java.util.ArrayList;

ArrayList successList = new ArrayList();
ArrayList failureList = new ArrayList();

String cleanValue(String value) {
    if (value == null) {
        return null;
    }

    value = value.trim();

    if (value.length() == 0) {
        return null;
    }

    if (&quot;null&quot;.equalsIgnoreCase(value)) {
        return null;
    }

    if (&quot;NOT_FOUND&quot;.equalsIgnoreCase(value)) {
        return null;
    }

    // 兼容 JSON 提取器偶尔提取成 [0] / [&quot;EURUSD&quot;] 的情况
    if (value.startsWith(&quot;[&quot;) &amp;&amp; value.endsWith(&quot;]&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1).trim();
    }

    if (value.startsWith(&quot;\&quot;&quot;) &amp;&amp; value.endsWith(&quot;\&quot;&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1).trim();
    }

    return value;
}

boolean isBlank(String value) {
    return value == null || value.trim().length() == 0;
}

boolean isNumber(String value) {
    if (value == null) {
        return false;
    }

    try {
        new BigDecimal(value.trim());
        return true;
    } catch (Exception e) {
        return false;
    }
}

boolean valueEquals(String leftValue, String rightValue) {
    leftValue = cleanValue(leftValue);
    rightValue = cleanValue(rightValue);

    if (leftValue == null &amp;&amp; rightValue == null) {
        return true;
    }

    if (leftValue == null || rightValue == null) {
        return false;
    }

    // 数字按数值比较，避免 0.01 和 0.0100 格式不同导致失败
    if (isNumber(leftValue) &amp;&amp; isNumber(rightValue)) {
        return new BigDecimal(leftValue).compareTo(new BigDecimal(rightValue)) == 0;
    }

    return leftValue.equals(rightValue);
}

void checkVarEquals(String leftVarName, String rightVarName) {
    String leftValue = cleanValue(vars.get(leftVarName));
    String rightValue = cleanValue(vars.get(rightVarName));

    if (isBlank(leftValue) || isBlank(rightValue)) {
        failureList.add(
            &quot;[失败] &quot; + leftVarName + &quot; = &quot; + rightVarName +
            &quot;，变量为空或未提取到，&quot; +
            leftVarName + &quot;=[&quot; + leftValue + &quot;]，&quot; +
            rightVarName + &quot;=[&quot; + rightValue + &quot;]&quot;
        );
        return;
    }

    if (valueEquals(leftValue, rightValue)) {
        successList.add(
            &quot;[成功] &quot; + leftVarName + &quot; = &quot; + rightVarName +
            &quot;，&quot; + leftVarName + &quot;=[&quot; + leftValue + &quot;]，&quot; +
            rightVarName + &quot;=[&quot; + rightValue + &quot;]&quot;
        );
    } else {
        failureList.add(
            &quot;[失败] &quot; + leftVarName + &quot; != &quot; + rightVarName +
            &quot;，&quot; + leftVarName + &quot;=[&quot; + leftValue + &quot;]，&quot; +
            rightVarName + &quot;=[&quot; + rightValue + &quot;]&quot;
        );
    }
}

// ========================
// 客户交易报告字段 vs 下单变量
// ========================

checkVarEquals(&quot;MT5_customer_cmd&quot;, &quot;MT5_cmd&quot;);
checkVarEquals(&quot;MT4_customer_cmd&quot;, &quot;MT4_cmd&quot;);

checkVarEquals(&quot;MT5_customer_lotSize&quot;, &quot;volume51&quot;);
checkVarEquals(&quot;MT4_customer_lotSize&quot;, &quot;volume41&quot;);

checkVarEquals(&quot;MT5_customer_symbol&quot;, &quot;symbol51&quot;);
checkVarEquals(&quot;MT4_customer_symbol&quot;, &quot;symbol41&quot;);

// ========================
// 输出断言结果
// ========================

String successDetail = &quot;&quot;;
String failureDetail = &quot;&quot;;

for (int i = 0; i &lt; successList.size(); i++) {
    successDetail = successDetail + successList.get(i) + &quot;\n&quot;;
}

for (int i = 0; i &lt; failureList.size(); i++) {
    failureDetail = failureDetail + failureList.get(i) + &quot;\n&quot;;
}

String finalDetail =
    &quot;========== 客户交易报告 JSR223 BeanShell 断言明细 ==========\n&quot; +
    &quot;\n【成功明细】\n&quot; +
    successDetail +
    &quot;\n【失败明细】\n&quot; +
    failureDetail +
    &quot;======================================================&quot;;

vars.put(&quot;customer_trade_report_assert_success_detail&quot;, successDetail);
vars.put(&quot;customer_trade_report_assert_failure_detail&quot;, failureDetail);
vars.put(&quot;customer_trade_report_assert_all_detail&quot;, finalDetail);

log.info(finalDetail);

if (failureList.size() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalDetail);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalDetail);
}</stringProp>
            </JSR223Assertion>
