                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取转入账户余额" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">client_toaccount_balance</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.accountId == ${toAccount})].balance</stringProp>
