                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.math.BigDecimal;

StringBuffer passCollect = new StringBuffer();
StringBuffer errorCollect = new StringBuffer();

int passCount = 0;
int failCount = 0;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }
    return value.trim();
}

boolean isInvalid(String value) {
    String text = clean(value);
    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

String getVar(String varName) {
    return clean(vars.get(varName));
}

String formatNum(BigDecimal num) {
    return num.stripTrailingZeros().toPlainString();
}

String normalizeNumber(String value) {
    try {
        return formatNum(new BigDecimal(clean(value)));
    } catch (Exception e) {
        return clean(value);
    }
}

boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText);
        BigDecimal actNum = new BigDecimal(actText);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        return false;
    }
}

void addPass(String message, StringBuffer passCollect) {
    String fullMsg = &quot;【成功】&quot; + message;
    passCollect.append(fullMsg).append(&quot;\n&quot;);
    log.info(fullMsg);
    System.out.println(fullMsg);
}

void addFail(String message, StringBuffer errorCollect) {
    String fullMsg = &quot;【失败】&quot; + message;
    errorCollect.append(fullMsg).append(&quot;\n&quot;);
    log.error(fullMsg);
    System.out.println(fullMsg);
}

boolean checkNumberEqual(
    String title,
    String expectedName,
    String expectedValue,
    String actualName,
    String actualValue,
    StringBuffer passCollect,
    StringBuffer errorCollect
) {
    if (isInvalid(expectedValue)) {
        addFail(
            title + &quot;，预期值为空或无效，&quot;
            + expectedName + &quot;=[&quot; + clean(expectedValue) + &quot;]&quot;,
            errorCollect
        );
        return false;
    }

    if (isInvalid(actualValue)) {
        addFail(
            title + &quot;，实际值提取失败，&quot;
            + actualName + &quot;=[&quot; + clean(actualValue) + &quot;]&quot;,
            errorCollect
        );
        return false;
    }

    boolean ok = numberEquals(expectedValue, actualValue);

    String detail = title
        + &quot;，预期 &quot; + expectedName + &quot;=[&quot; + normalizeNumber(expectedValue) + &quot;]&quot;
        + &quot;，实际 &quot; + actualName + &quot;=[&quot; + normalizeNumber(actualValue) + &quot;]&quot;;

    if (ok) {
        addPass(detail, passCollect);
        return true;
    } else {
        addFail(detail, errorCollect);
        return false;
    }
}

boolean checkTextEqual(
    String title,
    String expectedName,
    String expectedValue,
    String actualName,
    String actualValue,
    StringBuffer passCollect,
    StringBuffer errorCollect
) {
    if (isInvalid(expectedValue)) {
        addFail(
            title + &quot;，预期值为空或无效，&quot;
            + expectedName + &quot;=[&quot; + clean(expectedValue) + &quot;]&quot;,
            errorCollect
        );
        return false;
    }

    if (isInvalid(actualValue)) {
        addFail(
            title + &quot;，实际值提取失败，&quot;
            + actualName + &quot;=[&quot; + clean(actualValue) + &quot;]&quot;,
            errorCollect
        );
        return false;
    }

    boolean ok = clean(expectedValue).equals(clean(actualValue));

    String detail = title
        + &quot;，预期 &quot; + expectedName + &quot;=[&quot; + clean(expectedValue) + &quot;]&quot;
        + &quot;，实际 &quot; + actualName + &quot;=[&quot; + clean(actualValue) + &quot;]&quot;;

    if (ok) {
        addPass(detail, passCollect);
        return true;
    } else {
        addFail(detail, errorCollect);
        return false;
    }
}

// ----------------------读取实际提取值----------------------

String actTotal = getVar(&quot;get_total&quot;);
String actTradingAccount = getVar(&quot;tradingAccount&quot;);
String actDebitAmountUsd = getVar(&quot;debitAmountUsd&quot;);
String actCreditAmountUsd = getVar(&quot;creditAmountUsd&quot;);
String actCurrency = getVar(&quot;get_currency&quot;);

// ----------------------读取预期值----------------------

String expTotal = &quot;1&quot;;
String expTradingAccount = getVar(&quot;account&quot;);
String expDebitAmountUsd = getVar(&quot;amountUSD&quot;);
String expCreditAmountUsd = &quot;0&quot;;
String expCurrency = getVar(&quot;currencyUSD&quot;);

// ----------------------逐条断言----------------------

boolean r1 = checkNumberEqual(
    &quot;get_total = 1&quot;,
    &quot;固定值 1&quot;,
    expTotal,
    &quot;get_total&quot;,
    actTotal,
    passCollect,
    errorCollect
);
if (r1) { passCount++; } else { failCount++; }

boolean r2 = checkNumberEqual(
    &quot;debitAmountUsd = amountUSD&quot;,
    &quot;amountUSD&quot;,
    expDebitAmountUsd,
    &quot;debitAmountUsd&quot;,
    actDebitAmountUsd,
    passCollect,
    errorCollect
);
if (r2) { passCount++; } else { failCount++; }

boolean r3 = checkTextEqual(
    &quot;tradingAccount = account&quot;,
    &quot;account&quot;,
    expTradingAccount,
    &quot;tradingAccount&quot;,
    actTradingAccount,
    passCollect,
    errorCollect
);
if (r3) { passCount++; } else { failCount++; }

boolean r4 = checkNumberEqual(
    &quot;creditAmountUsd = 0&quot;,
    &quot;固定值 0&quot;,
    expCreditAmountUsd,
    &quot;creditAmountUsd&quot;,
    actCreditAmountUsd,
    passCollect,
    errorCollect
);
if (r4) { passCount++; } else { failCount++; }

boolean r5 = checkTextEqual(
    &quot;get_currency = currency&quot;,
    &quot;currency&quot;,
    expCurrency,
    &quot;get_currency&quot;,
    actCurrency,
    passCollect,
    errorCollect
);
if (r5) { passCount++; } else { failCount++; }

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;&quot;;
finalMessage = finalMessage + &quot;========== 未入金退回-资金报表入金查询 JSR223 断言结果明细 ==========\n&quot;;
finalMessage = finalMessage + &quot;断言总数：5，成功：&quot; + passCount + &quot;，失败：&quot; + failCount + &quot;\n&quot;;

finalMessage = finalMessage + &quot;\n【断言成功明细】\n&quot;;
if (passCollect.length() &gt; 0) {
    finalMessage = finalMessage + passCollect.toString();
} else {
    finalMessage = finalMessage + &quot;无成功断言\n&quot;;
}

finalMessage = finalMessage + &quot;\n【断言失败明细】\n&quot;;
if (errorCollect.length() &gt; 0) {
    finalMessage = finalMessage + errorCollect.toString();
} else {
    finalMessage = finalMessage + &quot;无失败断言\n&quot;;
}

if (failCount &gt; 0) {
    finalMessage = finalMessage + &quot;\n【最终结果】存在断言失败\n&quot;;
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    finalMessage = finalMessage + &quot;\n【最终结果】全部断言通过\n&quot;;
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}

finalMessage = finalMessage + &quot;========================================&quot;;

log.info(finalMessage);
System.out.println(finalMessage);

vars.put(&quot;assert_result_detail&quot;, finalMessage);
vars.put(&quot;fund_deposit_query_no_refund_assert_detail&quot;, finalMessage);

String oldMsg = prev.getResponseMessage();
if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}</stringProp>
