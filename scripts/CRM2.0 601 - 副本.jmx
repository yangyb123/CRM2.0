                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取顶部统计栏账户余额" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">admin_top_balance</stringProp>
