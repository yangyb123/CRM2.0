            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell 预处理程序" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import java.io.File;
import java.io.BufferedReader;
import java.io.FileReader;

// 使用 FileServer.getBaseDir 保证路径统一
String baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir();
String csvPath = baseDir + File.separator + &quot;mima.csv&quot;;

log.info(&quot;读取密码文件: &quot; + csvPath);

BufferedReader br = null;
try {
    br = new BufferedReader(new FileReader(csvPath));
    String header = br.readLine();   // 跳过列头 &quot;pwd&quot;
    String password = br.readLine(); // 读取第二行：密码值

    if (password != null &amp;&amp; !password.isEmpty()) {
        vars.put(&quot;pwd&quot;, password);
        log.info(&quot;读取到密码: &quot; + password);
    } else {
        log.error(&quot;CSV文件中没有密码数据！&quot;);
        vars.put(&quot;pwd&quot;, &quot;&quot;);
    }
} catch (Exception e) {
    log.error(&quot;读取密码文件失败: &quot; + e.toString());
} finally {
    if (br != null) {
        try { br.close(); } catch (Exception ex) {}
    }
}
</stringProp>
            </BeanShellPreProcessor>
