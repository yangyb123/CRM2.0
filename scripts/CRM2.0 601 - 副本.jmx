          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="将新密码写回 CSV" enabled="true">
            <stringProp name="BeanShellSampler.query">import java.io.FileWriter;
import java.io.BufferedWriter;
// 获取 .jmx 文件所在目录（与 CSV Data Set Config 解析相对路径的基准一致）
String baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir();
String csvPath = baseDir + java.io.File.separator + &quot;mima.csv&quot;;

String newPassword = vars.get(&quot;newPassword&quot;);

log.info(&quot;写入CSV路径: &quot; + csvPath);
log.info(&quot;写入密码: &quot; + newPassword);

BufferedWriter bw = null;
try {
    bw = new BufferedWriter(new FileWriter(csvPath, false));
    bw.write(&quot;pwd&quot;);
    bw.newLine();
    bw.write(newPassword);
    bw.newLine();
    bw.flush();
} catch (Exception e) {
    log.error(&quot;写入失败: &quot; + e.toString());
} finally {
    if (bw != null) {
        try { bw.close(); } catch (Exception ex) {}
    }
}
</stringProp>
          </BeanShellSampler>
