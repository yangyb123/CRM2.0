              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="资金报表查询" enabled="true">
                <stringProp name="HTTPSampler.domain">${ip}</stringProp>
                <stringProp name="HTTPSampler.protocol">https</stringProp>
                <stringProp name="HTTPSampler.path">/v1/admin/report/funds/list</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
                <stringProp name="HTTPSampler.method">POST</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                  <collectionProp name="Arguments.arguments">
                    <elementProp name="" elementType="HTTPArgument">
                      <boolProp name="HTTPArgument.always_encode">false</boolProp>
                      <stringProp name="Argument.value">{&#xd;
    &quot;mtTransactionId&quot;: &quot;${orderId_final1}&quot;,&#xd;
    &quot;userSearchType&quot;: &quot;username&quot;,&#xd;
    &quot;page&quot;: 1,&#xd;
    &quot;pageSize&quot;: 10&#xd;
}</stringProp>
                      <stringProp name="Argument.metadata">=</stringProp>
                    </elementProp>
                  </collectionProp>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取total" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">get_total</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.total</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取debitAmountUsd" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">debitAmountUsd</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer Out&quot;)].debitAmountUsd</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取OuttradingAccount" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">OuttradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer Out&quot;)].tradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取creditAmountUsd" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">creditAmountUsd</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer In&quot;)].creditAmountUsd</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取IntradingAccount" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">IntradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer In&quot;)].tradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
