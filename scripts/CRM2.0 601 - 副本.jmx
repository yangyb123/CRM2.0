            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="判断返佣金额" enabled="true">
              <stringProp name="BeanShellAssertion.query">import java.math.BigDecimal;

String lotStr = vars.get(&quot;volume41&quot;);
String commStr = vars.get(&quot;admin_commission41&quot;);

if (lotStr == null) {
    lotStr = &quot;&quot;;
}

if (commStr == null) {
    commStr = &quot;&quot;;
}

lotStr = lotStr.trim();
commStr = commStr.trim();

// 兼容 JSON 提取器提取出 [&quot;0.5600&quot;] 这种格式
commStr = commStr.replace(&quot;[&quot;, &quot;&quot;).replace(&quot;]&quot;, &quot;&quot;).replace(&quot;\&quot;&quot;, &quot;&quot;).trim();

BigDecimal lot = new BigDecimal(lotStr);
BigDecimal rate = new BigDecimal(&quot;35&quot;);
BigDecimal expected = lot.multiply(rate);
BigDecimal actual = new BigDecimal(commStr);

String expectedText = expected.stripTrailingZeros().toPlainString();

// 保存预期返佣金额，后续接口/断言可直接调用
vars.put(&quot;expect_commission41&quot;, expectedText);  //变量名 一个短名方便用
vars.put(&quot;MT4_expected_commission&quot;, expectedText);    //变量名  一个语义清楚 两个变量名都可以用

// 可选：也保存实际返佣金额，方便后续调试或对比
vars.put(&quot;actual_commission41&quot;, commStr);

String msg = &quot;MT4订单返佣金额断言：&quot;
    + &quot;volume41=[&quot; + lotStr + &quot;]，&quot;
    + &quot;返佣参数=[35]，&quot;
    + &quot;预期返佣金额=volume41*35=[&quot; + expectedText + &quot;]，&quot;
    + &quot;实际返佣金额admin_commission41=[&quot; + commStr + &quot;]&quot;;

if (actual.compareTo(expected) == 0) {
    Failure = false;

    prev.setSuccessful(true);
    prev.setResponseCode(&quot;200&quot;);
    prev.setResponseMessage(&quot;断言通过：&quot; + msg);

    log.info(&quot;断言通过：&quot; + msg);
} else {
    Failure = true;
    FailureMessage = &quot;断言失败：&quot; + msg;

    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(&quot;断言失败：&quot; + msg);

    log.error(&quot;断言失败：&quot; + msg);
}
</stringProp>
