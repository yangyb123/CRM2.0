                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="判断get_user_info 接口返回 balance 与首页返回是否相等" enabled="true">
                  <stringProp name="scriptLanguage">beanshell</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import java.math.BigDecimal;
import java.math.RoundingMode;

// ----------------------工具方法----------------------

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    value = value.trim();

    // 去掉常见不可见字符
    value = value.replace(&quot;\uFEFF&quot;, &quot;&quot;);
    value = value.replace(&quot;\u200B&quot;, &quot;&quot;);
    value = value.replace(&quot;\u00A0&quot;, &quot;&quot;);

    // 兼容提取到 &quot;100.00&quot; 这种带双引号的情况
    if (value.startsWith(&quot;\&quot;&quot;) &amp;&amp; value.endsWith(&quot;\&quot;&quot;) &amp;&amp; value.length() &gt;= 2) {
        value = value.substring(1, value.length() - 1);
    }

    return value.trim();
}

String getVar(String name) {
    return clean(vars.get(name));
}

boolean isExtractFail(String value) {
    String text = clean(value);

    return text.length() == 0
        || &quot;NOT_FOUND&quot;.equals(text)
        || &quot;null&quot;.equalsIgnoreCase(text);
}

// 改造：金额专用，统一保留2位小数四舍五入后再比较，解决浮点精度丢失
boolean numberEquals(String expected, String actual) {
    try {
        String expText = clean(expected);
        String actText = clean(actual);

        if (expText.length() == 0 || actText.length() == 0) {
            return false;
        }

        BigDecimal expNum = new BigDecimal(expText).setScale(2, RoundingMode.HALF_UP);
        BigDecimal actNum = new BigDecimal(actText).setScale(2, RoundingMode.HALF_UP);

        return expNum.compareTo(actNum) == 0;
    } catch (Exception e) {
        log.error(&quot;数值转换异常:&quot; + e.getMessage());
        return false;
    }
}

// ----------------------读取实际值----------------------

String actclientAccountBalance = getVar(&quot;account_list_balance&quot;);

// ----------------------读取预期值----------------------

String expFromBalanceafter = getVar(&quot;balance_after&quot;);

String errorCollect = &quot;&quot;;
String passCollect = &quot;&quot;;

// ----------------------提取值检查----------------------

if (isExtractFail(actclientAccountBalance)) {
    errorCollect += &quot;【account_list_balance 提取失败】实际值：[&quot; + actclientAccountBalance + &quot;]\n&quot;;
}

if (isExtractFail(expFromBalanceafter)) {
    errorCollect += &quot;【balance_after 提取失败】实际值：[&quot; + expFromBalanceafter + &quot;]\n&quot;;
}


// ----------------------1. account_list_balance = balance_after 金额校验----------------------

if (!isExtractFail(actclientAccountBalance) &amp;&amp; !isExtractFail(expFromBalanceafter)) {
    if (!numberEquals(expFromBalanceafter, actclientAccountBalance)) {
        errorCollect += &quot;【account_list_balance 断言失败】预期 balance_after：[&quot; + expFromBalanceafter + &quot;]，实际 account_list_balance：[&quot; + actclientAccountBalance + &quot;]\n&quot;;
    }
}


// ----------------------收集断言检查明细----------------------
passCollect += &quot;【检查】account_list_balance = balance_after，预期：[&quot; + expFromBalanceafter + &quot;]，实际：[&quot; + actclientAccountBalance + &quot;]\n&quot;;

// ----------------------统一输出断言结果----------------------

String finalMessage = &quot;========== JSR223 断言结果明细 ==========\n&quot;;

if (passCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言检查明细】\n&quot; + passCollect;
}

if (errorCollect.length() &gt; 0) {
    finalMessage += &quot;\n【断言失败明细】\n&quot; + errorCollect;
} else {
    finalMessage += &quot;\n【最终结果】全部断言通过\n&quot;;
}

finalMessage += &quot;========================================&quot;;

// 1. 输出到 jmeter.log
log.info(finalMessage);

// 2. 保存到 JMeter 变量，可用 Debug Sampler 查看
vars.put(&quot;assert_result_detail&quot;, finalMessage);

// 3. 写入当前请求的 Response Message，可在察看结果树中查看
String oldMsg = prev.getResponseMessage();

if (oldMsg == null) {
    oldMsg = &quot;&quot;;
}

if (oldMsg.length() &gt; 0) {
    prev.setResponseMessage(oldMsg + &quot;\n&quot; + finalMessage);
} else {
    prev.setResponseMessage(finalMessage);
}

// 4. 控制断言成功/失败
if (errorCollect.length() &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMessage);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(finalMessage);
}</stringProp>
                </JSR223Assertion>
