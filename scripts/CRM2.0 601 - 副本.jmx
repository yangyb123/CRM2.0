            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取MT4订单的佣金" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">MT4_commission_Amount</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.orderId == ${mt4_order_id})].commissionAmount</stringProp>
