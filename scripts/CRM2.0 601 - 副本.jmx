                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取IntradingAccount" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">IntradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Different Name Transfer In&quot;)].tradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
