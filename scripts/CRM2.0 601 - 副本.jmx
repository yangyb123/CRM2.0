                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取creditAmountUsd" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">creditAmountUsd</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Namesake Transfer In&quot;)].creditAmountUsd</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取IntradingAccount" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">IntradingAccount</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.transactionTypeName == &quot;Namesake Transfer In&quot;)].tradingAccount</stringProp>
