              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">// 获取原始订单号
String orderId = vars.get(&quot;orderNumber&quot;);

// 核心：只保留下划线前面的纯数字
if(orderId != null &amp;&amp; orderId.contains(&quot;_&quot;)){
    orderId = orderId.substring(0, orderId.indexOf(&quot;_&quot;));
}

// 存回变量
vars.put(&quot;orderId_final1&quot;, orderId);

// 日志查看
log.info(&quot;处理后的订单号：&quot; + orderId);</stringProp>
                <stringProp name="scriptLanguage">beanshell</stringProp>
                <stringProp name="TestPlan.comments">从名为“${orderNumber_}”的字符串中提取下划线 _ 之前的部分，并将其保存为新变量 orderId_final</stringProp>
