                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取转出账户余额" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">admin_account_balance</stringProp>
