            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="拼接出金请求参数" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput

def paymentType = vars.get(&quot;paymentType&quot;)
def info = [:]

switch(paymentType) {
    case &quot;bank&quot;:
        info = [
            bankCode: 15382,
            bankName: &quot;test&quot;,
            bankBranch: &quot;teat&quot;,
            accountHolderName: &quot;test Hani01&quot;,
            accountNumber: &quot;***2010&quot;,
            bankCardPictures: []
        ]
        break
    case &quot;crypto&quot;:
        info = [
            walletAddress: &quot;12345&quot;
        ]
        break
    case &quot;eWallet&quot;:
        info = [
            walletName: &quot;ABC1236&quot;,
            accountNumber: &quot;110101&quot;,
            accountHolderName: &quot;test Hani01&quot;
        ]
        break
    case &quot;card&quot;:
        info = [
            bankCode: 15384
        ]
        break
    case &quot;wireTransfer&quot;:
        info = [
            bankCode: 15462,
            bankName: &quot;China bank&quot;,
            bankBranch: &quot;beijing bank&quot;,
            beneficiaryCountry: 3,
            accountHolderName: &quot;test Hani01&quot;,
            accountNumber: &quot;**0203&quot;,
            iban: &quot;testIBAN&quot;,
            swiftCode: &quot;testSwift&quot;,
            bankAddress: &quot;test bank address&quot;,
            beneficiaryAddress: &quot;test test&quot;,
            intermediaryBank: &quot;&quot;,
            bankCardPictures: []
        ]
        break
}

// 构建完整请求体
def body = [
    token: vars.get(&quot;token&quot;),
    accountId: vars.get(&quot;accountId&quot;).toInteger(),
    sourceType: vars.get(&quot;sourceType&quot;).toInteger(),
    amount: vars.get(&quot;amount&quot;).toBigDecimal(),
    channelId: vars.get(&quot;channelId&quot;).toInteger(),
    paymentMethod: vars.get(&quot;paymentMethod&quot;).toInteger(),
    currencyId: vars.get(&quot;currencyId&quot;).toInteger()
] + [(paymentType + &quot;Info&quot;): info]

// 存到变量中供 HTTP 请求使用
vars.put(&quot;requestBody&quot;, JsonOutput.toJson(body))</stringProp>
            </JSR223PreProcessor>
