              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取status" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">get_status</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.id == ${order_id})].status</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
