              </JSONPostProcessor>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取fromCurrency" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">get_fromCurrency</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[?(@.id == ${order_id})].fromCurrency</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
