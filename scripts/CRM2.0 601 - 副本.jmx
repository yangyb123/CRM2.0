          <hashTree>
            <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="异名转账前端" enabled="true">
              <boolProp name="TransactionController.parent">true</boolProp>
              <boolProp name="TransactionController.includeTimers">false</boolProp>
