            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
              <stringProp name="scriptLanguage">beanshell</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.math.BigDecimal;

String passMsg = &quot;&quot;, failMsg = &quot;&quot;;
int pass = 0, fail = 0;

// 工具简化
String getVal(String var) {
    String v = vars.get(var);
    return v == null ? &quot;&quot; : v.trim();
}

// 余额校验 balance_after - balance_before = 300
try {
    BigDecimal bB = new BigDecimal(getVal(&quot;balance_before&quot;));
    BigDecimal bA = new BigDecimal(getVal(&quot;balance_after&quot;));
    BigDecimal diff = bA.subtract(bB);
    if (diff.compareTo(new BigDecimal(&quot;300&quot;)) == 0) {
        passMsg += &quot;【成功】余额变动校验：after-before=300，实际差值=&quot; + diff + &quot;\n&quot;;
        pass++;
    } else {
        failMsg += &quot;【失败】余额变动校验：预期300，实际差值=&quot; + diff + &quot;，before=&quot; + bB + &quot;，after=&quot; + bA + &quot;\n&quot;;
        fail++;
    }
} catch (Exception e) {
    failMsg += &quot;【失败】余额变量异常：&quot; + e.getMessage() + &quot;\n&quot;;
    fail++;
}

// 信用校验 credit_after - credit_before = 10
try {
    BigDecimal cB = new BigDecimal(getVal(&quot;credit_before&quot;));
    BigDecimal cA = new BigDecimal(getVal(&quot;credit_after&quot;));
    BigDecimal diff = cA.subtract(cB);
    if (diff.compareTo(new BigDecimal(&quot;10&quot;)) == 0) {
        passMsg += &quot;【成功】信用变动校验：after-before=10，实际差值=&quot; + diff + &quot;\n&quot;;
        pass++;
    } else {
        failMsg += &quot;【失败】信用变动校验：预期10，实际差值=&quot; + diff + &quot;，before=&quot; + cB + &quot;，after=&quot; + cA + &quot;\n&quot;;
        fail++;
    }
} catch (Exception e) {
    failMsg += &quot;【失败】信用变量异常：&quot; + e.getMessage() + &quot;\n&quot;;
    fail++;
}

// 汇总输出
String result = &quot;==========断言汇总==========\n总数：2，成功：&quot; + pass + &quot;，失败：&quot; + fail + &quot;\n&quot;;
result += &quot;\n成功明细：\n&quot; + (passMsg.isEmpty() ? &quot;无&quot; : passMsg);
result += &quot;\n失败明细：\n&quot; + (failMsg.isEmpty() ? &quot;无&quot; : failMsg);
result += &quot;\n============================&quot;;

log.info(result);
System.out.println(result);
vars.put(&quot;assert_result_detail&quot;, result);

// 设置断言状态
if (fail &gt; 0) {
    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(result);
} else {
    AssertionResult.setFailure(false);
    AssertionResult.setFailureMessage(result);
}

// 追加到响应信息
String respMsg = prev.getResponseMessage() == null ? &quot;&quot; : prev.getResponseMessage();
prev.setResponseMessage(respMsg + &quot;\n&quot; + result);</stringProp>
            </JSR223Assertion>
