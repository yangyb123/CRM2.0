                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取转入账户余额" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">admin_toaccount_balance</stringProp>
