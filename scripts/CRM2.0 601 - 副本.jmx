}


// ----------------------1. get_after_balance = to_balance_after----------------------

if (!isExtractFail(actAdminToAccountBalance) &amp;&amp; !isExtractFail(expToBalanceafter)) {
    if (!numberEquals(expToBalanceafter, actAdminToAccountBalance)) {
        errorCollect += &quot;【get_after_balance 断言失败】预期 to_balance_after：[&quot; + expToBalanceafter + &quot;]，实际 get_after_balance：[&quot; + actAdminToAccountBalance + &quot;]\n&quot;;
    }
}

// ----------------------收集断言检查明细----------------------
