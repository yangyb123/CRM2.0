        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="历史订单三端对比" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="判断MT5历史订单三端是否一致" enabled="true">
            <stringProp name="scriptLanguage">beanshell</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.math.BigDecimal;

boolean hasFailure = false;

StringBuilder passMsg = new StringBuilder();
StringBuilder failMsg = new StringBuilder();

passMsg.append(&quot;========== MT5 历史字段对比通过明细 ==========\n&quot;);
failMsg.append(&quot;========== MT5 历史字段对比失败明细 ==========\n&quot;);


// ===================== 获取变量 =====================

String mt5_order_id = vars.get(&quot;mt5_order_id&quot;);
String MT5_cmd = vars.get(&quot;MT5_cmd&quot;);
String symbol51 = vars.get(&quot;symbol51&quot;);
String volume51 = vars.get(&quot;volume51&quot;);

String client_history_orderId51 = vars.get(&quot;client_history_orderId51&quot;);
String client_history_cmd51 = vars.get(&quot;client_history_cmd51&quot;);
String client_history_Symbol51 = vars.get(&quot;client_history_Symbol51&quot;);
String client_history_Volume51 = vars.get(&quot;client_history_Volume51&quot;);

String admin_history_orderId51 = vars.get(&quot;admin_history_orderId51&quot;);
String admin_history_cmd51 = vars.get(&quot;admin_history_cmd51&quot;);
String admin_history_Symbol51 = vars.get(&quot;admin_history_Symbol51&quot;);
String admin_history_Volume51 = vars.get(&quot;admin_history_Volume51&quot;);


// ===================== 工具方法 =====================

boolean eq(String a, String b) {
    return String.valueOf(a).trim().equals(String.valueOf(b).trim());
}

boolean numEq(String a, String b) {
    try {
        BigDecimal n1 = new BigDecimal(String.valueOf(a).trim());
        BigDecimal n2 = new BigDecimal(String.valueOf(b).trim());
        return n1.compareTo(n2) == 0;
    } catch (Exception e) {
        return eq(a, b);
    }
}

void check(boolean condition, String fieldName, String detail) {
    if (condition) {
        passMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比通过：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    } else {
        hasFailure = true;
        failMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比失败：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    }
}


// ===================== 断言逻辑 =====================

check(
    eq(client_history_orderId51, admin_history_orderId51)
        &amp;&amp; eq(admin_history_orderId51, mt5_order_id),
    &quot;订单号 orderId&quot;,
    &quot;client_history_orderId51=[&quot; + client_history_orderId51 + &quot;]，&quot;
        + &quot;admin_history_orderId51=[&quot; + admin_history_orderId51 + &quot;]，&quot;
        + &quot;mt5_order_id=[&quot; + mt5_order_id + &quot;]&quot;
);

check(
    eq(client_history_cmd51, admin_history_cmd51)
        &amp;&amp; eq(admin_history_cmd51, MT5_cmd),
    &quot;交易方向 cmd&quot;,
    &quot;client_history_cmd51=[&quot; + client_history_cmd51 + &quot;]，&quot;
        + &quot;admin_history_cmd51=[&quot; + admin_history_cmd51 + &quot;]，&quot;
        + &quot;MT5_cmd=[&quot; + MT5_cmd + &quot;]&quot;
);

check(
    eq(client_history_Symbol51, admin_history_Symbol51)
        &amp;&amp; eq(admin_history_Symbol51, symbol51),
    &quot;品种 symbol&quot;,
    &quot;client_history_Symbol51=[&quot; + client_history_Symbol51 + &quot;]，&quot;
        + &quot;admin_history_Symbol51=[&quot; + admin_history_Symbol51 + &quot;]，&quot;
        + &quot;symbol51=[&quot; + symbol51 + &quot;]&quot;
);

check(
    numEq(client_history_Volume51, admin_history_Volume51)
        &amp;&amp; numEq(admin_history_Volume51, volume51),
    &quot;手数 volume&quot;,
    &quot;client_history_Volume51=[&quot; + client_history_Volume51 + &quot;]，&quot;
        + &quot;admin_history_Volume51=[&quot; + admin_history_Volume51 + &quot;]，&quot;
        + &quot;volume51=[&quot; + volume51 + &quot;]&quot;
);


// ===================== 输出到取样器结果 =====================

String finalMsg = &quot;&quot;;

if (hasFailure) {
    finalMsg = failMsg.toString() + &quot;\n&quot; + passMsg.toString();

    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMsg);

    // 失败时显示到“查看结果树 -&gt; 取样器结果 -&gt; Response message”
    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(finalMsg);

    log.error(finalMsg);
} else {
    finalMsg = passMsg.toString();

    AssertionResult.setFailure(false);

    // 成功时也显示到“查看结果树 -&gt; 取样器结果 -&gt; Response message”
    prev.setSuccessful(true);
    prev.setResponseCode(&quot;200&quot;);
    prev.setResponseMessage(finalMsg);

    log.info(finalMsg);
}

// 存成变量，后面如果加 Debug Sampler 也能看到
vars.put(&quot;MT5_history_assert_detail&quot;, finalMsg);
</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="判断MT4历史订单三端是否一致" enabled="true">
            <stringProp name="scriptLanguage">beanshell</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.math.BigDecimal;

boolean hasFailure = false;

StringBuilder passMsg = new StringBuilder();
StringBuilder failMsg = new StringBuilder();

passMsg.append(&quot;========== MT4 历史字段对比通过明细 ==========\n&quot;);
failMsg.append(&quot;========== MT4 历史字段对比失败明细 ==========\n&quot;);


// ===================== 获取变量 =====================

// 基准参数
String mt4_order_id = vars.get(&quot;mt4_order_id&quot;);
String MT4_cmd = vars.get(&quot;MT4_cmd&quot;);
String symbol41 = vars.get(&quot;symbol41&quot;);
String volume41 = vars.get(&quot;volume41&quot;);

// 客户端历史订单提取参数
String client_history_orderId41 = vars.get(&quot;client_history_orderId41&quot;);
String client_history_cmd41 = vars.get(&quot;client_history_cmd41&quot;);
String client_history_Symbol41 = vars.get(&quot;client_history_Symbol41&quot;);
String client_history_Volume41 = vars.get(&quot;client_history_Volume41&quot;);

// 后台历史订单提取参数
String admin_history_orderId41 = vars.get(&quot;admin_history_orderId41&quot;);
String admin_history_cmd41 = vars.get(&quot;admin_history_cmd41&quot;);
String admin_history_Symbol41 = vars.get(&quot;admin_history_Symbol41&quot;);
String admin_history_Volume41 = vars.get(&quot;admin_history_Volume41&quot;);


// ===================== 工具方法 =====================

String clean(String value) {
    if (value == null) {
        return &quot;&quot;;
    }

    String v = value.trim();

    // 兼容 JSON 提取器返回 [&quot;xxx&quot;] 的情况
    if (v.startsWith(&quot;[&quot;) &amp;&amp; v.endsWith(&quot;]&quot;) &amp;&amp; v.length() &gt;= 2) {
        v = v.substring(1, v.length() - 1).trim();
    }

    // 去掉首尾双引号
    if (v.startsWith(&quot;\&quot;&quot;) &amp;&amp; v.endsWith(&quot;\&quot;&quot;) &amp;&amp; v.length() &gt;= 2) {
        v = v.substring(1, v.length() - 1).trim();
    }

    return v;
}

boolean eq(String a, String b) {
    return clean(a).equals(clean(b));
}

boolean numEq(String a, String b) {
    try {
        BigDecimal n1 = new BigDecimal(clean(a));
        BigDecimal n2 = new BigDecimal(clean(b));
        return n1.compareTo(n2) == 0;
    } catch (Exception e) {
        return eq(a, b);
    }
}

void check(boolean condition, String fieldName, String detail) {
    if (condition) {
        passMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比通过：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    } else {
        hasFailure = true;
        failMsg.append(&quot;【&quot;).append(fieldName).append(&quot;】对比失败：&quot;)
            .append(detail)
            .append(&quot;\n&quot;);
    }
}


// ===================== 断言逻辑 =====================

// 订单号：client_history_orderId41 = admin_history_orderId41 = mt4_order_id
check(
    eq(client_history_orderId41, admin_history_orderId41)
        &amp;&amp; eq(admin_history_orderId41, mt4_order_id),
    &quot;订单号 orderId&quot;,
    &quot;client_history_orderId41=[&quot; + client_history_orderId41 + &quot;]，&quot;
        + &quot;admin_history_orderId41=[&quot; + admin_history_orderId41 + &quot;]，&quot;
        + &quot;mt4_order_id=[&quot; + mt4_order_id + &quot;]&quot;
);

// 交易方向：client_history_cmd41 = admin_history_cmd41 = MT4_cmd
check(
    eq(client_history_cmd41, admin_history_cmd41)
        &amp;&amp; eq(admin_history_cmd41, MT4_cmd),
    &quot;交易方向 cmd&quot;,
    &quot;client_history_cmd41=[&quot; + client_history_cmd41 + &quot;]，&quot;
        + &quot;admin_history_cmd41=[&quot; + admin_history_cmd41 + &quot;]，&quot;
        + &quot;MT4_cmd=[&quot; + MT4_cmd + &quot;]&quot;
);

// 品种：client_history_Symbol41 = admin_history_Symbol41 = symbol41
check(
    eq(client_history_Symbol41, admin_history_Symbol41)
        &amp;&amp; eq(admin_history_Symbol41, symbol41),
    &quot;品种 symbol&quot;,
    &quot;client_history_Symbol41=[&quot; + client_history_Symbol41 + &quot;]，&quot;
        + &quot;admin_history_Symbol41=[&quot; + admin_history_Symbol41 + &quot;]，&quot;
        + &quot;symbol41=[&quot; + symbol41 + &quot;]&quot;
);

// 手数：client_history_Volume41 = admin_history_Volume41 = volume41
// 使用数值比较，1 和 1.0 会认为一致
check(
    numEq(client_history_Volume41, admin_history_Volume41)
        &amp;&amp; numEq(admin_history_Volume41, volume41),
    &quot;手数 volume&quot;,
    &quot;client_history_Volume41=[&quot; + client_history_Volume41 + &quot;]，&quot;
        + &quot;admin_history_Volume41=[&quot; + admin_history_Volume41 + &quot;]，&quot;
        + &quot;volume41=[&quot; + volume41 + &quot;]&quot;
);


// ===================== 输出到取样器结果 =====================

String finalMsg = &quot;&quot;;

if (hasFailure) {
    finalMsg = failMsg.toString() + &quot;\n&quot; + passMsg.toString();

    AssertionResult.setFailure(true);
    AssertionResult.setFailureMessage(finalMsg);

    // 失败时显示到：查看结果树 -&gt; 取样器结果 -&gt; Response message
    prev.setSuccessful(false);
    prev.setResponseCode(&quot;500&quot;);
    prev.setResponseMessage(finalMsg);

    log.error(finalMsg);
} else {
    finalMsg = passMsg.toString();

    AssertionResult.setFailure(false);

    // 成功时也显示到：查看结果树 -&gt; 取样器结果 -&gt; Response message
    prev.setSuccessful(true);
    prev.setResponseCode(&quot;200&quot;);
    prev.setResponseMessage(finalMsg);

    log.info(finalMsg);
}

// 存成变量，方便 Debug Sampler 查看
vars.put(&quot;MT4_history_assert_detail&quot;, finalMsg);</stringProp>
          </JSR223Assertion>
