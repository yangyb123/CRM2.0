            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="数据库查询入金后余额" enabled="false">
              <stringProp name="dataSource">crm_db</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="query">SELECT balance FROM mt_account WHERE id = ${accountId};</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">balance</stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell断言" enabled="true">
                <stringProp name="BeanShellAssertion.query">// 获取 JMeter 中的变量
String amountStr = vars.get(&quot;amount&quot;);
String refundAmountStr = vars.get(&quot;refundamount&quot;);
String balanceBeforeStr = vars.get(&quot;balance_before&quot;);
String balanceAfterStr = vars.get(&quot;balance&quot;);

// 确保变量不为空
if (amountStr == null || refundAmountStr == null || balanceBeforeStr == null || balanceAfterStr == null) {
    Failure = true;
    FailureMessage = &quot;某些变量为空，请检查 CSV 或 JDBC 数据！&quot;;
} else {
    try {
        // 将字符串转换为数字（BigDecimal）
        double amount = Double.parseDouble(amountStr);
        double refundAmount = Double.parseDouble(refundAmountStr);
        double balanceBefore = Double.parseDouble(balanceBeforeStr);
        double balanceAfter = Double.parseDouble(balanceAfterStr);

        // 计算期望增加的余额
        double expectedIncrease = amount - refundAmount;

        // 计算实际增加的余额
        double actualIncrease = balanceAfter - balanceBefore;

        // 比较期望增加余额和实际增加余额
        if (Math.abs(actualIncrease - expectedIncrease) &gt; 0.01) {  // 允许0.01的浮动误差
            Failure = true;
            FailureMessage = 
                &quot;入金金额校验失败！\n&quot; +
                &quot;期望增加余额: &quot; + expectedIncrease + &quot;\n&quot; +
                &quot;实际增加余额: &quot; + actualIncrease + &quot;\n&quot; +
                &quot;入金金额: &quot; + amount + &quot;\n&quot; +
                &quot;退回金额: &quot; + refundAmount + &quot;\n&quot; +
                &quot;入金前余额: &quot; + balanceBefore + &quot;\n&quot; +
                &quot;入金后余额: &quot; + balanceAfter;
        } else {
            log.info(&quot;入金金额校验成功 ✅，实际增加余额 = &quot; + actualIncrease);
        }
    } catch (NumberFormatException e) {
        Failure = true;
        FailureMessage = &quot;数字格式转换错误：&quot; + e.getMessage();
    }
}</stringProp>
                <stringProp name="BeanShellAssertion.filename"></stringProp>
