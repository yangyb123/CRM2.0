            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell断言" enabled="true">
              <stringProp name="BeanShellAssertion.query">// BeanShell断言 - 简单对比
String clientCountStr = vars.get(&quot;client_pending_orderId_matchNr&quot;);
String adminCountStr = vars.get(&quot;admin_pending_orderId_matchNr&quot;);

int clientCount = 0;
int adminCount = 0;

try {
    clientCount = Integer.parseInt(clientCountStr);
    adminCount = Integer.parseInt(adminCountStr);
} catch (Exception e) {
    // 如果解析失败，说明没有提取到数据
}

log.info(&quot;客户端订单数: &quot; + clientCount);
log.info(&quot;后台订单数: &quot; + adminCount);

// 1. 对比数量
if (clientCount != adminCount) {
    Failure = true;
    FailureMessage = &quot;订单数量不一致: 客户端=&quot; + clientCount + &quot;, 后台=&quot; + adminCount;
    return;
}

// 2. 对比每个订单
for (int i = 1; i &lt;= clientCount; i++) {
    String clientId = vars.get(&quot;client_pending_orderId_&quot; + i);
    String clientType = vars.get(&quot;client_pending_orderType_&quot; + i);
    String clientSymbol = vars.get(&quot;client_pending_instrument_&quot; + i);
    String clientLots = vars.get(&quot;client_pending_lotSize_&quot; + i);
    
    String adminId = vars.get(&quot;admin_pending_orderId_&quot; + i);
    String adminType = vars.get(&quot;admin_pending_orderSide_&quot; + i);
    String adminSymbol = vars.get(&quot;admin_pending_symbol_&quot; + i);
    String adminLots = vars.get(&quot;admin_pending_volumeCurrent_&quot; + i);
    
    // 对比订单ID
    if (!clientId.equals(adminId)) {
        Failure = true;
        FailureMessage = &quot;订单ID不匹配: 位置&quot; + i + &quot;, 客户端=&quot; + clientId + &quot;, 后台=&quot; + adminId;
        return;
    }
    
    // 对比买卖方向
    if (!clientType.equals(adminType)) {
        Failure = true;
        FailureMessage = &quot;订单&quot; + clientId + &quot;方向不一致: 客户端=&quot; + clientType + &quot;, 后台=&quot; + adminType;
        return;
    }
    
    // 对比品种
    if (!clientSymbol.equals(adminSymbol)) {
        Failure = true;
        FailureMessage = &quot;订单&quot; + clientId + &quot;品种不一致: 客户端=&quot; + clientSymbol + &quot;, 后台=&quot; + adminSymbol;
        return;
    }

    //对比手数
     if (!clientLots.equals(adminLots)) {
        Failure = true;
        FailureMessage = &quot;订单&quot; + clientId + &quot;品种不一致: 客户端=&quot; + clientLots + &quot;, 后台=&quot; + adminLots;
        return;
    }
    
    log.info(&quot;√ 订单&quot; + clientId + &quot;验证通过&quot;);
}

log.info(&quot;√ 所有订单对比通过&quot;);</stringProp>
