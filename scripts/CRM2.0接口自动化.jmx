            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="MT4order_id写入本地" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">try {
    // 1. 获取提取出来的参数
    String mt5 = vars.get(&quot;mt4_order_id&quot;);

    // 2. 保存路径
    String fileName = &quot;D:\\AutomationProject\\CRM2.0Interface\\close_order_1012_MT4.txt&quot;;

    // 3. 打开文件,并在每次运行后在后面加一行，不会删掉之前的内容
    FileWriter fw = new FileWriter(fileName, true);
    BufferedWriter bw = new BufferedWriter(fw);

    // 4. 写入一行
    bw.write(&quot;${mt4_order_id}&quot;);
    bw.newLine(); // 换行

    bw.close();
    fw.close();
} catch (Exception e) {
    log.error(&quot;写入文件失败&quot;, e);
}</stringProp>
