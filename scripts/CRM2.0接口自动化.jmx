              <stringProp name="JSONPostProcessor.referenceNames">admin_pending_orderId51</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[*].orderId</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="提取orderSide" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">admin_pending_orderSide51</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.items[*].orderSide</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">-1</stringProp>
              <stringProp name="TestPlan.comments">买卖方向</stringProp>
            </JSONPostProcessor>
