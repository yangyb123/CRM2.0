            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="MT5order_id写入本地" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">try {
    // 1. 获取订单号
    String orderId = vars.get(&quot;mt5_order_id&quot;);
    log.info(&quot;获取到订单号：&quot; + orderId);

    if (orderId == null || orderId.isBlank()) {
        log.info(&quot;订单号为空，不写入&quot;);
        return;
    }

    // ====================== 核心修复 ======================
    // 直接写入 【桌面】，绝对有权限，100% 创建文件
    String desktopPath = System.getProperty(&quot;user.home&quot;) + &quot;\\Desktop\\&quot;;
    String fileName = desktopPath + &quot;order_ids.txt&quot;;
    // ======================================================

    // 自动创建父目录（保险）
    java.io.File file = new java.io.File(fileName);
    file.getParentFile().mkdirs();

    // 写入（追加模式，UTF-8）
    try (java.io.PrintWriter pw = new java.io.PrintWriter(new java.io.FileWriter(file, true))) {
        pw.println(orderId.trim());
        log.info(&quot;✅ 写入成功！文件路径：&quot; + fileName);
    }

} catch (Exception e) {
    log.error(&quot;❌ 写入失败：&quot;, e);
}</stringProp>
